  "summary": "[{\"x\":0.18448637696776943,\"width\":0.7358490306032455,\"y\":0.8938110750630519,\"height\":0.014657980456026065,\"text\":\"Talent Time, for its fifth year, was held on 28th November and the first week of\"},{\"x\":0.12159331072164435,\"width\":0.7966456731758584,\"",
