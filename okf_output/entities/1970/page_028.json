t\":\"Day will be held once every year. It not\",\"width\":0.3752620549888288,\"height\":0.0146930160273947,\"x\":0.5387840654039086},{\"y\":0.37029571803413763,\"text\":\"only brings the teachers and the students\",\"width\":0.3777665347281427,\"height\":0.018064270889331935,\"x\":0.5364532529774187},{\"y\":0.3556162715941986,\"text\":\"together, but also provides an opportunity\",\"width\":0.37759761146409043,\"height\":0.01711058725363268,\"x\":0.5344802077458826},{\"y\":0.3444767446054853,\"text\":\"for us to pay our respects to the teachers\",\"width\":0.3773584661905427,\"height\":0.013177978565327875,\"x\":0.536687649504309},{\"y\":0.32855154091662,\"text\":\"and Show our gratitude towards them fon\",\"width\":0.3735347256162541,\"height\":0.016526646567478154,\"x\":0.5386076437134084},{\"y\":0.31654662463416494,\"text\":\"making us useful persons in society.\",\"width\":0.31885888143630936,\"height\":0.015045921499643677,\"x\":0.540747334250972},{\"y\":0.09738372126596406,\"text\":\"Tea\",\"width\":0.025157232275574315,\"height\":0.01017441827233534,\"x\":0.7148846958817796}]",
