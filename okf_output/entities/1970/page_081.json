t\":\"The Club printed\",\"width\":0.17400418242977567,\"y\":0.15261627948634982,\"height\":0.016113362017205923,\"x\":0.11320755341299471},{\"text\":\"two designs of\",\"width\":0.16352201158554064,\"y\":0.15537459264094156,\"height\":0.011776570000167075,\"x\":0.2872117378130998},{\"text\":\"Christmas Card for sale in the school.\",\"width\":0.3752620549888288,\"y\":0.1423452766562363,\"height\":0.011726384364820874,\"x\":0.07337526650453727},{\"text\":\"They were： （i The Coming of the Magi\",\"width\":0.3731656150781985,\"y\":0.1263843650409514,\"height\":0.014657980456026065,\"x\":0.07547169483686184},{\"text\":\"（i1） The Nativity. Each card was sold at\",\"width\":0.3773584661905427,\"y\":0.11335504878639668,\"height\":0.013098439020908681,\"x\":0.07337527277474967},{\"text\":\"30 cents each with the envelope.\",\"width\":0.30398321286306446,\"y\":0.10029069799695822,\"height\":0.013081394655308332,\"x\":0.07337527494512731},{\"text\":\"3. Open Day Display\",\"width\":0.2033542981152252,\"y\":0.5654069771207975,\"height\":0.016026247751441014,\"x\":0.4884695994748822},{\"text\":\"On the School's Open Day on\",\"width\":0.33333331419405565,\"y\":0.5436046512065682,\"height\":0.01453488377872425,\"x\":0.5345912087048589},{\"text\":\"December 14. 1969, the Club had a Work\",\"width\":0.3752620549888288,\"y\":0.5289902279412186,\"height\":0.014657980456026065,\"x\":0.4905660398404913},{\"text\":\"Display in the Teachers' Dining Room.\",\"width\":0.3752620549888288,\"y\":0.5145348839194893,\"height\":0.016084008729419064,\"x\":0.4926624782445792},{\"text\":\"The works on display included: Chinese\",\"width\":0.37735846619054275,\"y\":0.499999999749703,\"height\":0.013081395276594576,\"x\":0.49056604363428863},{\"text\":\"Paintings, Oil Paintings, Pencil Drawings\",\"width\":0.37557406349218014,\"y\":0.48347015899411383,\"height\":0.016833606682693514,\"x\":0.4924953746048405},{\"text\":\"and Poster Drawings.\",\"width\":0.19287211291653195,\"y\":0.47093023265927914,\"height\":0.011627906774465013,\"x\":0.49056604238869417},{\"text\":\"4. Chinese Painting Class\",\"width\":0.23899370482364918,\"y\":0.4389534883889662,\"height\":0.01609537143272377,\"x\":0.4884696061835632},{\"text\":\"The Club organised a Chinese Paint-\",\"width\":0.33333331419405565,\"y\":0.4185667754721877,\"height\":0.013119270747181666,\"x\":0.5345912087048589},{\"text\":\"ing Class in March 1970 with the aim of\",\"width\":0.379454906101173,\"y\":0.40390879448900674,\"height\":0.013355048859934882,\"x\":0.49056605274081805},{\"text\":\"promoting Chinese style painting.\",\"width\":0.3039832128630644,\"y\":0.3879478828521763,\"height\":0.014668396319162613,\"x\":0.49056604935987225},{\"text\":\"But due\",\"width\":0.07346748072138842,\"y\":0.38939406102998286,\"height\":0.01190955196219079,\"x\":0.7945031580654125},{\"text\":\"to insufficient participants, the class was\",\"width\":0.3773584948994591,\"y\":0.3735465115626727,\"height\":0.01453488377872425,\"x\":0.4905660308521574},{\"text\":\"postponed\",\"width\":0.08811126019970383,\"y\":0.3589127755388408,\"height\":0.013279100971035573,\"x\":0.4905355655389463},{\"text\":\"6. Star Cover Design Competition\",\"width\":0.3228511433498207,\"y\":0.3283387621893751,\"height\":0.01628664495113996,\"x\":0.4884696024865153},{\"text\":\"In April 1970 the Club organised a\",\"width\":0.335429754104686,\"y\":0.30813953521231685,\"height\":0.013081394655308443,\"x\":0.532494762360655},{\"text\":\"Star Cover Design Competition, in which\",\"width\":0.3773584948994591,\"y\":0.290553746031903,\"height\":0.016286644951140072,\"x\":0.4905660380848616},{\"text\":\"the best design would be used as the cover\",\"width\":0.37945490610117294,\"y\":0.2790697675946494,\"height\":0.014534883778724361,\"x\":0.4905660458225791},{\"text\":\"for the Star 1970.\",\"width\":0.1698113169629733,\"y\":0.26308139531994024,\"height\":0.01453488377872425,\"x\":0.48846960527113387},{\"text\":\"7. Miscellaneous\",\"width\":0.157232706208107