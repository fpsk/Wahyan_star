  "class_designation": "[{\"height\":0.03199473452490398,\"y\":0.786319218585916,\"text\":\"The\",\"x\":0.7148846951559822,\"width\":0.07547170041533757},{\"height\":0.030634043193407012,\"y\":0.7325581391377655,\"text\":\"Librarians\",\"x\":0.7148846949074078,\"width\":0.20545073802585545},{\"height\":0.01453488377872425,\"y\":0.6090116276358317,\"text\":\"Under the guidance of Fr. Brosnan，\",\"x\":0.16142558605884635,\"width\":0.3312368742834254},{\"height\":0.01707092558522183,\"y\":0.5942380443914058,\"text\":\"the school library\",\"x\":0.11495515692580713,\"width\":0.16634033719885497},{\"height\":0.011736800227957422,\"y\":0.5973837209829225,\"text\":\"had a wonderful and\",\"x\":0.29350104853995,\"width\":0.1991614182939646},{\"height\":0.013355048859934882,\"y\":0.5798045602168089,\"text\":\"most successful year. Our librarians went\",\"x\":0.11530398716604545,\"width\":0.379454906101173},{\"height\":0.01453488377872425,\"y\":0.5654069769575372,\"text\":\"to work at the very beginning of the term，\",\"x\":0.11530399611507108,\"width\":0.3773584661905427},{\"height\":0.01602805072399227,\"y\":0.5505995258089413,\"text\":\"and indeed we have a hard time.\",\"x\":0.11515194408466763,\"width\":0.31895181219867125},{\"height\":0.01453488377872425,\"y\":0.5494186045859286,\"text\":\"Nearly\",\"x\":0.4318658272606876,\"width\":0.05870020983921165},{\"height\":0.013174191204655017,\"y\":0.5363372097217645,\"text\":\"all our books and periodicals need re-\",\"x\":0.1153039848353857,\"width\":0.37735849489945905},{\"height\":0.01468828120526744,\"y\":0.5201954398265366,\"text\":\"grouping and re-cataloguing, not to men-\",\"x\":0.1174004218374821,\"width\":0.37735849489945905},{\"height\":0.011627906774464902,\"y\":0.5087209303821474,\"text\":\"tion the new\",\"x\":0.11740042177869793,\"width\":0.14046121563198205},{\"height\":0.010174418272335228,\"y\":0.508720930422941,\"text\":\"ones that\",\"x\":0.255765201889665,\"width\":0.09643605645826597},{\"height\":0.013081394655308554,\"y\":0.5058139536171131,\"text\":\"are constantly\",\"x\":0.3501048242245401,\"width\":0.140461215631982},{\"height\":0.016062230162977698,\"y\":0.4912052117472324,\"text\":\"fowing into our library.\",\"x\":0.11740041872805121,\"width\":0.22431865415815352},{\"height\":0.01315525315871846,\"y\":0.4912052115381218,\"text\":\"Fortunately we\",\"x\":0.34381551076988676,\"width\":0.148846960920045},{\"height\":0.013158093679223049,\"y\":0.4767441864659504,\"text\":\"have the full co-operation from our fellow\",\"x\":0.11740042530083343,\"width\":0.37526205498882875},{\"height\":0.013423760628467285,\"y\":0.4621439851729936,\"text\":\"students and teachers.\",\"x\":0.11518602233241515,\"width\":0.1973749916169964},{\"height\":0.011627906774464902,\"y\":0.4360465116418373,\"text\":\"Our librarians all come from Form 6\",\"x\":0.15932914669752146,\"width\":0.33333331419405576},{\"height\":0.01391438288486746,\"y\":0.4196416459878578,\"text\":\"and Form 4.\",\"x\":0.1173064256832932,\"width\":0.11758840566296007},{\"height\":0.013166615862023168,\"y\":0.42005813993615393,\"text\":\"The Form 6 boys are es-\",\"x\":0.25576520698269384,\"width\":0.23689726491301888},{\"height\":0.013355048859934882,\"y\":0.4039087944999078,\"text\":\"pecially enthusiastic and have devoted\",\"x\":0.11740042279908655,\"width\":0.3752620549888288},{\"height\":0.013081394655308443,\"y\":0.38953488415853765,\"text\":\"much time to their duty.\",\"x\":0.11740043048618991,\"width\":0.24109013037982124},{\"height\":0.013081394655308443,\"y\":0.3895348838496714,\"text\":\"They are dis-\",\"x\":0.35639413345732274,\"width\":0.1362683358107214},{\"height\":0.01316282850135031,\"y\":0.37491856655522837,\"text\":\"tinguished from their junior colleagues by\",\"x\":0.11740042373724167,\"width\":0.37526205498882875},{\"height\":0.01453488377872425,\"y\":0.6090116276358317,\"text\":\"the fact that they have the benefit of two\",\"x\":0.5387840656921685,\"width\":0.3752620549888288},{\"height\":0.01609726511306009,\"y\":0.5930232560851871,\"text\":\"more years’education. This does\",\"x\":0.5387840721670797,\"width\":0.3270440231710813},{\"height\":0.010258692328238617,\"y\":0.5959302328938711,\"text\":\"not\",\"x\":0.8846960168355135,\"width\":0.031446541241621606},{\"height\":0.014672184301121605,\"y\":0.57980456015607,\"text\":\"mean that Form 4 boys have not rendered\",\"x\":0.5387840763386911,\"width\":0.3773584661905427},{\"height\":0.013094651660235823,\"y\":0.5654069773089737,\"text\":\"valuable service.\",\"x\":0.5387840719244023,\"width\":0.14465408109878442},{\"height\":0.014534883778724361,\"y\":0.5363372092370913,\"text\":\"Our library is constantly praised, but\",\"x\":0.58280922776946,\"width\":0.335429754104686},{\"height\":0.01467975902246732,\"y\":0.5218023257947464,\"text\":\"there are also some complaints from our\",\"x\":0.5387840814400187,\"width\":0.3773584661905426},{\"height\":0.013182713387455136,\"y\":0.5071661235295886,\"text\":\"fellow students. We do welcome construc-\",\"x\":0.5387840696362242,\"width\":0.37735849489945905},{\"height\":0.01885625360843024,\"y\":0.4898146020031412,\"text\":\"tive criticism because from it, we can learn\",\"x\":0.5406331066933092,\"width\":0.3757553602991974},{\"height\":0.016065070683482396,\"y\":0.47383720925258044,\"text\":\"and make progress. In fact, we felt a lit-\",\"x\":0.5408805051051662,\"width\":0.3752620549888288},{\"height\":0.017123514976874255,\"y\":0.46067267472843754,\"text\":\"tle bit worried if we do not receive any\",\"x\":0.5407112944117343,\"width\":0.3756165239795243},{\"height\":0.014879875307362678,\"y\":0.445768482505867,\"text\":\"criticism.\",\"x\":0.5402255094075415,\"width\":0.0792207260347153},{\"height\":0.011627906774464902,\"y\":0.4200581395996862,\"text\":\"we\",\"x\":0.5807127873705906,\"width\":0.03563941388565306},{\"height\":0.013119270747181666,\"y\":0.41856677532683884,\"text\":\"plan to further re-group our\",\"x\":0.6289308209452409,\"width\":0.2893081621975687},{\"height\":0.016286644951140072,\"y\":0.40390879453459994,\"text\":\"books and periodicals during our summer\",\"x\":0.5408805133757281,\"width\":0.3773584661905427},{\"height\":0.013081394655308443,\"y\":0.38953488399502023,\"text\":\"vacation and we, sincerely hope that there\",\"x\":0.5408804991512879,\"width\":0.3752620549888288},{\"height\":0.01453488377872425,\"y\":0.373546511356762,\"text\":\"will be a better service available next year.\",\"x\":0.5408805204337291,\"width\":0.3773584661905427},{\"height\":0.021904590619115205,\"y\":0.29796511679644844,\"text\":\"Joint School Science Exhibition\",\"x\":0.26834380648837197,\"width\":0.5052410997765757},{\"height\":0.013115483386508697,\"y\":0.26017441878789827,\"text\":\"56½2Y\",\"x\":0.8134171909954964,\"width\":0.048218028229133014},{\"height\":0.011627906774465013,\"y\":0.06540697690346509,\"text\":\"76\",\"x\":0.12159329187059857,\"width\":0.025157232275574357}]",
