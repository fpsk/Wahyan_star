\":0.3966516420987758,\"width\":0.37184874068859014,\"height\":0.013232078847006945,\"x\":0.09243697791200739,\"text\":\"the first time for the Science Society to\"},{\"y\":0.3837209303332869,\"width\":0.37184874068859014,\"height\":0.013081395234588844,\"x\":0.09243697791200739,\"text\":\"sponsor such a Quiz. The Quiz committee\"},{\"y\":0.3720930233585845,\"width\":0.3739495707667151,\"height\":0.010174418447559619,\"x\":0.09243698555501756,\"text\":\"encountered a number of difiiculties in the\"},{\"y\":0.3560849967751881,\"width\":0.3697478822220203,\"height\":0.011647561559044672,\"x\":0.09453782821672078,\"text\":\"setting ot questions, especlally those for\"},{\"y\":0.34288473945323394,\"width\":0.3718487406885901,\"height\":0.014810045074050149,\"x\":0.09243697206641924,\"text\":\"Forms 1 & 2. The winners of the Science\"},{\"y\":0.3312942691356845,\"width\":0.20798318552416425,\"height\":0.011728986800292551,\"x\":0.09243698126627917,\"text\":\"Quiz were as follows：—\"},{\"y\":0.3168061816528178,\"width\":0.1302521035837573,\"height\":0.010302640051513157,\"x\":0.13445378176904568,\"text\":\"Senior Section：\"},{\"y\":0.30377906986415615,\"width\":0.1848739411110102,\"height\":0.010174418447559619,\"x\":0.13445378805794023,\"text\":\"Intermediate Section：\"},{\"y\":0.2891178367389853,\"width\":0.13235293366188225,\"height\":0.011912427559562122,\"x\":0.1344537869243109,\"text\":\"Junior Section：\"},{\"y\":0.2732558140711746,\"width\":0.32773108194040695,\"height\":0.013081395234588844,\"x\":0.13655462982811578,\"text\":\"A film show group was formed early\"},{\"y\":0.25861185742035364,\"width\":0.10255099274391351,\"height\":0.016410834391656026,\"x\":0.09147606447664887,\"text\":\"in the year.\"},{\"y\":0.2583415291485074,\"width\":0.21698758857194766,\"height\":0.017132844452081186,\"x\":0.24972218628296294,\"text\":\"gqroup organised a series\"},{\"y\":0.2469414038528429,\"width\":0.3025210074491279,\"height\":0.013233014712852653,\"x\":0.09243697904854524,\"text\":\"of film shows on science subjects.\"},{\"y\":0.248379907609506,\"width\":0.05055852490802143,\"height\":0.010507626604128184,\"x\":0.4137963669574576,\"text\":\"These\"},{\"y\":0.2340116277728409,\"width\":0.3718487406885901,\"height\":0.011641945749885863,\"x\":0.09243696799604127,\"text\":\"Shows were usually held during lunch time\"},{\"y\":0.2234162728418505,\"width\":0.16187078431595203,\"height\":0.011016291798274125,\"x\":0.0923839373311371,\"text\":\"in the school hall\"},{\"y\":0.21947674430373276,\"width\":0.1848739411110102,\"height\":0.013081395234588733,\"x\":0.2794117704809094,\"text\":\"The film show group\"},{\"y\":0.2063747583995369,\"width\":0.3739495707667151,\"height\":0.013200257566001294,\"x\":0.0924369748407322,\"text\":\"also put on a number of film shows for\"},{\"y\":0.19317450095547906,\"width\":0.20168066690134445,\"height\":0.013220847842774663,\"x\":0.09243697999470585,\"text\":\"other clubs on request.\"},{\"y\":0.1786864135402101,\"width\":0.327731081940407,\"height\":0.014627539566541059,\"x\":0.13655462862013262,\"text\":\"From December onwards, the Science\"},{\"y\":0.1648040339246606,\"width\":0.06526381381722383,\"height\":0.01632216355912708,\"x\":0.08921683173729698,\"text\":\"Society\"},{\"y\":0.16702515708036036,\"width\":0.11350551161655159,\"height\":0.013333407817774257,\"x\":0.16593632024315425,\"text\":\"managed to\"},{\"y\":0.16569767460654272,\"width\":0.17226890386537064,\"height\":0.013081395234588733,\"x\":0.29411765042025584,\"text\":\"put two pages of\"},{\"y\":0.15406976752320933,\"width\":0.20378151117369186,\"height\":0.013081395234588844,\"x\":0.09033613177309817,\"text\":\"‘Scientia’ in the Starlet.\"},{\"y\":0.13940759799634184,\"width\":0.056722688896711476,\"height\":0.013208680972696785,\"x\":0.13655462137097202,\"text\":\"During\"},{\"y\":0.13926583545569393,\"width\":0.08839867170466933,\"height\":0.013619492918310439,\"x\":0.1952964615538841,\"text\":\"the year，\"},{\"y\":0.14098837191043767,\"width\":0.18067226676053777,\"height\":0.01162790714811679,\"x\":0.2836134434404595,\"text\":\"the members of the\"},{\"y\":0.12491951039686222,\"width\":0.3760504008448401,\"height\":0.016097875080489432,\"x\":0.09033614787589919,\"text\":\"society visited the Fairchild Semiconductor\"},{\"y\":0.11191860460884939,\"width\":0.3718487406885901,\"height\":0.014610693367235306,\"x\":0.09243697065710564,\"text\":\"Co. Ltd.， Wah Kiu Yat Po and the South\"},{\"y\":0.10029069762506959,\"width\":0.1848739411110102,\"height\":0.011750512942911628,\"x\":0.0945378216713856,\"text\":\"China Morning Post.\"},{\"y\":0.10029069739493379,\"width\":0.1848739411110102,\"height\":0.011750512942911628,\"x\":0.28151261046690385,\"text\":\"The last two visits\"},{\"y\":0.08430232570865559,\"width\":0.24369748137718023,\"height\":0.014538627398528403,\"x\":0.09033613021477131,\"text\":\"were led by Mr. S.H. Chau.\"},{\"y\":0.6955052843955244,\"width\":0.07600512837254725,\"height\":0.011605710424458793,\"x\":0.5355268485270559,\"text\":\"City Hall\"},{\"y\":0.6960721182929079,\"width\":0.11554621496865913,\"height\":0.01032323063532914,\"x\":0.6092436974526453,\"text\":\"School Science\"},{\"y\":0.6960721183602407,\"width\":0.06932772614235105,\"height\":0.009014810045074206,\"x\":0.7352941209886985,\"text\":\"Exhibition\"},{\"y\":0.5475446037172733,\"width\":0.2901865972474563,\"height\":0.04589916703321828,\"x\":0.5544865323424025,\"text\":\"Photography\"},{\"y\":0.48969736036695843,\"width\":0.11554621496865924,\"height\":0.03799098518995503,\"x\":0.6407563038359677,\"text\":\"Club\"},{\"y\":0.44040697673117424,\"width\":0.3319327704851017,\"height\":0.01162790714811679,\"x\":0.5525210138645918,\"text\":\"The Club did not take a rest but con-\"},{\"y\":0.4243399870837239,\"width\":0.3739495707667151,\"height\":0.01609787508048932,\"x\":0.5084033649667825,\"text\":\"tinued with talks, picnics and discussions\"},{\"y\":0.4127495171537712,\"width\":0.22058822276980383,\"height\":0.01