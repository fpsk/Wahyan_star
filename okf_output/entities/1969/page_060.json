      "club_name": "[{\"height\":0.0177190721649485,\"text\":\"STARLET - Wah Yan Student Paper\",\"width\":0.476890741723337,\"y\":0.8704896907058914,\"x\":0.30462185126018027},{\"height\":0.01598837203586223,\"text\":\"We planned to print nine issues of the\",\"width\":0.3298319365971575,\"y\":0.819767441689191,\"x\":0.18277310431171542},{\"height\":0.014534883892413197,\"text\":\"Starlet this year, but only six actually came\",\"width\":0.37394957529087547,\"y\":0.8037790696453632,\"x\":0.13865545978103297},{\"x\":0.14075630257693356,\"width\":0.13445377972008243,\"y\":0.7892441862974116,\"text\":\"out. This was\",\"height\":0.013081394520002454},{\"x\":0.2751105625589516,\"width\":0.23976495037096635,\"y\":0.7906284673340017,\"text\":\"due to certain drawbacks，\",\"height\":0.01395301351842193},{\"x\":0.1407563035962625,\"width\":0.1911764722612564,\"y\":0.7731958760745506,\"text\":\"mainly financial ones.\",\"height\":0.013208762886597891},{\"x\":0.3466386556452627,\"width\":0.16806722820527292,\"y\":0.7731958764885145,\"text\":\"In the third issue，\",\"height\":0.016108247422680355},{\"x\":0.1386554646149754,\"width\":0.3760504247091246,\"y\":0.758698453569255,\"text\":\"a stenciled bulletin of the Science Society，\",\"height\":0.013208762886597891},{\"x\":0.1365546330393455,\"width\":0.3781512456860147,\"y\":0.7412790698686968,\"text\":\"‘The Scientia'， was distributed together with\",\"height\":0.01613072390408854},{\"x\":0.1405724571575915,\"width\":0.37220922009698276,\"y\":0.7254003729154895,\"text\":\"the Starlet. Later, it was incorporated into\",\"height\":0.017622156855986337},{\"x\":0.13865547809160728,\"width\":0.3760503962677657,\"y\":0.7106958765551327,\"text\":\"the School paper and became the Science\",\"height\":0.016108247422680466},{\"x\":0.14075630411550777,\"width\":0.3718487258726264,\"y\":0.6947674421469564,\"text\":\"Page'. Because of the extra pages devoted\",\"height\":0.01463977454863874},{\"x\":0.1386554635120343,\"width\":0.37605042470912453,\"y\":0.6800902063672531,\"text\":\"to this, the cost of printing each issue\",\"height\":0.014819587628865927},{\"x\":0.13865546304809875,\"width\":0.37605042470912453,\"y\":0.6642441860334445,\"text\":\"mounted from $400 to $600. This is the\",\"height\":0.014557360373821493},{\"x\":0.1407563094659067,\"width\":0.37394957529087547,\"y\":0.6497093028308418,\"text\":\"main reason why we failed to produce nine\",\"height\":0.013081394520002454},{\"x\":0.13821005918390525,\"width\":0.05761349723367967,\"y\":0.6357047422889934,\"text\":\"issueS.\",\"height\":0.010567259542720864},{\"x\":0.18487395179070681,\"width\":0.32983193659715754,\"y\":0.6046511627776305,\"text\":\"At the beginning of the year, we were\",\"height\":0.014549868008525202},{\"x\":0.1386554656318732,\"width\":0.3739495752908754,\"y\":0.5901162792582317,\"text\":\"invited by Ying Wa Girls’School to a\",\"height\":0.01598837203586223},{\"x\":0.1407563094659067,\"width\":0.37394957529087547,\"y\":0.5740979380208191,\"text\":\"meeting of the editors of secondary school\",\"height\":0.013208762886598002},{\"x\":0.14073865867257862,\"width\":0.060959658662737365,\"y\":0.5580888715023633,\"text\":\"papers.\",\"height\":0.010275745514741863},{\"x\":0.22478991790953415,\"width\":0.2899159682985787,\"y\":0.5579896904937394,\"text\":\"A similar meeting is now being\",\"height\":0.013231239368006076},{\"x\":0.1407563080927741,\"width\":0.2626050396267765,\"y\":0.5421511633194371,\"text\":\"organised by Queen's College.\",\"height\":0.01454986739404418},{\"x\":0.18277312033062315,\"width\":0.33193275757404767,\"y\":0.5144974224813275,\"text\":\"We face the difficulty of getting enough\",\"height\":0.014572345104414075},{\"x\":0.14075631553007312,\"width\":0.37184872587262646,\"y\":0.5014534886305407,\"text\":\"articles in almost every issue. Certain im-\",\"height\":0.01017441823310461},{\"x\":0.14285713861279728,\"width\":0.3676470554774872,\"y\":0.48546511629526945,\"text\":\"provements can stll be made in this respect.\",\"height\":0.01017441823310461},{\"x\":0.1407562986290723,\"width\":0.3739495752908755,\"y\":0.46939433002918884,\"text\":\"We can get a reporter from each class，\",\"height\":0.013208762886598002},{\"x\":0.1407563094659067,\"width\":0.37394957529087547,\"y\":0.4519974224958623,\"text\":\"starting from Form I, responsible for\",\"height\":0.014572345104414075},{\"x\":0.14075630108005255,\"width\":0.37394957529087547,\"y\":0.4375000001565065,\"text\":\"encouraging their classmates to contribute\",\"height\":0.014534883277932398},{\"x\":0.1407563094659067,\"width\":0.37394957529087547,\"y\":0.42296511665183945,\"text\":\"more articles. These reporters can also ask\",\"height\":0.011635398741849934},{\"x\":0.1407563085310328,\"width\":0.37394957529087547,\"y\":0.4055232557863515,\"text\":\"their teachers to put up the best essays\",\"height\":0.014579836855229678},{\"x\":0.1407563094659067,\"width\":0.37394957529087547,\"y\":0.3909883725619465,\"text\":\"written by their classmates on the notice-\",\"height\":0.013081394520002454},{\"x\":0.1405328378385367,\"width\":0.37239260997932205,\"y\":0.3734164697585498,\"text\":\"boards in their classrooms. This may\",\"height\":0.01852757476039768},{\"x\":0.1406059529148957,\"width\":0.37426009804760313,\"y\":0.35883902959358915,\"text\":\"stimulate students to write better essays\",\"height\":0.015451014041900635},{\"x\":0.5588235270079237,\"width\":0.37394957529087547,\"y\":0.8226744184462352,\"text\":\"which may be a good source of articles for\",\"height\":0.014632282797823248},{\"x\":0.5545741411106769,\"width\":0.10303659430198986,\"y\":0.8065044186829418,\"text\":\"the Starlet.\",\"height\":0.013444651647941397},{\"x\":0.6008403481737603,\"width\":0.3319327575740477,\"y\":0.7834302330520333,\"text\":\"Most students like to know more about\",\"height\":0.011672859953850812},{\"x\":0.5586045169969818,\"width\":0.37429508091907915,\"y\":0.7644453974574508,\"text\":\"past students. A past students’corner can\",\"height\":0.016991992586666838},{\"x\":0.5588235408900691,\"width\":0.23949578135011362,\"y\":0.7483891754616738,\"text\":\"be set up for this purpose.\",\"height\":0.013238731118821567},{\"x\":0.6008403472213796,\"width\":0.3319327575740476,\"y\":0.7222938141338728,\"text\":\"Interviews with teachers and students\",\"height\":0.011717813531148091},{\"x\":0.5588235439856963,\"width\":0.36974787645437734,\"y\":0.7048969070443256,\"text\":\"on certain topics can be most interesting\",\"height\":0.014579836855229678},{\"x\":0.5588235270079237,\"width\":0.37394957529087547,\"y\":0.6889534887320046,\"text\":\"Through these interviews, their opinions are\",\"height\":0.013081394520002565},{\"x\":0.5588235318418662,\"width\":0.37605042470912453,\"y\":0.6729651167843301,\"text\":\"expressed and better relations between tea-\",\"height\":0.013081394520002454},{\"x\":0.5588235413285223,\"width\":0.3319327575740477,\"y\":0.6597938146902143,\"text\":\"chers and students can be established.\",\"height\":0.01171781291666718},{\"x\":0.6023861459968141,\"width\":0.1229274355132004,\"y\":0.6305421670494351,\"text\":\"Besides essay\",\"height\":0.014503364710463762},{\"x\":0.7247899249298424,\"width\":0.20798318228317214,\"y\":0.630798969244871,\"text\":\"competitions, cartoon\",\"height\":0.013208762886598002},{\"x\":0.5588235279427975,\"width\":0.37394957529087547,\"y\":0.614690721719468,\"text\":\"competitions can be held. Certain cartoons\",\"height\":0.014819587628866038},{\"x\":0.5588235279427975,\"width\":0.37394957529087547,\"y\":0.5988372091293748,\"text\":\"and drawings can often give the paper a\",\"height\":0.014564852739117784},{\"x\":0.5588235379470771,\"width\":0.30042015850710624,\"y\":0.5843023260139812,\"text\":\"more lively and pleasant outlook.\",\"height\":0.013081394520002565},{\"x\":0.6029411890243416,\"width\":0.32983190815579855,\"y\":0.5566860472826153,\"text\":\"The success of the Starlet depends on\",\"height\":0.014534882663451487},{\"x\":0.5588235354217891,\"width\":0.37394957529087547,\"y\":0.5421511632777894,\"text\":\"the constant support of the students, the\",\"height\":0.013081394520002565},{\"x\":0.5588235355163269,\"width\":0.37394957529087547,\"y\":0.5260953607349135,\"text\":\"persisting encouragement of the Principal\",\"height\":0.014602313951118773},{\"x\":0.5588235327852344,\"width\":0.37394957529087547,\"y\":0.5101744183372237,\"text\":\"and the teachers, and the generous financial\",\"height\":0.014632282797823248},{\"x\":0.5588235347635258,\"width\":0.37394957529087547,\"y\":0.4954896908067048,\"text\":\"help of the companies advertising in the\",\"height\":0.014819587628865927},{\"x\":0.556722690364097,\"width\":0.06722688986004122,\"y\":0.47965116325962076,\"text\":\"Starlet.\",\"height\":0.013081394520002565},{\"x\":0.6386554712693874,\"width\":0.2941176386937179,\"y\":0.47965116332623914,\"text\":\"We wish to take this opportunity\",\"height\":0.013081394520002454},{\"x\":0.5588235354217891,\"width\":0.37394957529087547,\"y\":0.4651162794570721,\"text\":\"to thank them all. We are also grateful to\",\"height\":0.011687844069962594},{\"x\":0.5588235270079237,\"width\":0.37394957529087547,\"y\":0.45058139553992105,\"text\":\"our staff who devoted so much time and\",\"height\":0.011725305281963472},{\"x\":0.5588235336632753,\"width\":0.18697478764543773,\"y\":0.43298969047435953,\"text\":\"energy to the Starlet.\",\"height\":0.013231239368006076},{\"x\":0.6029411883873458,\"width\":0.3319327575740476,\"y\":0.40399484552311904,\"text\":\"We are looking forward to a more\",\"height\":0.013208762886597891},{\"x\":0.5588235347985399,\"width\":0.37394957529087547,\"y\":0.38949742298390877,\"text\":\"successful year for the Starlet and hope\",\"height\":0.013208762886597891},{\"x\":0.5588235320499404,\"width\":0.37394957529087547,\"y\":0.37338917512503245,\"text\":\"that it will never fail in its purpose as a\",\"height\":0.014819587628866038},{\"x\":0.5588235318418662,\"width\":0.37605042470912453,\"y\":0.3588917528202539,\"text\":\"bond between the school and the students.\",\"height\":0.011747781763371767},{\"x\":0.21206470947182204,\"width\":0.09687898321231725,\"y\":0.3121766276446455,\"text\":\"JUNIOR\",\"height\":0.018088604986053136},{\"x\":0.1869747884025462,\"width\":0.14495798414928937,\"y\":0.2805232557698596,\"text\":\"RED CROSS\",\"height\":0.01598837203586234},{\"x\":0.21844286201602928,\"width\":0.08622352052601498,\"y\":0.2484409649227406,\"text\":\"CADET\",\"height\":0.017652954022909007},{\"x\":0.20168067608327828,\"width\":0.11554621316957786,\"y\":0.21649484511911365,\"text\":\"UNIT 34\",\"height\":0.016108247422680355},{\"x\":0.1428571504340441,\"width\":0.20798318228317217,\"y\":0.09729381461949671,\"text\":\"Fr. Deignan and Mr Adrian Lee\",\"height\":0.010309278043275083},{\"x\":0.1848739533997303,\"width\":0.12394957529087544,\"y\":0.08279639181422827,\"text\":\"With The Cadets\",\"height\":0.010309278043274972},{\"x\":0.13865546311244523,\"width\":0.025210082808723,\"y\":0.05668604688439749,\"text\":\"48\",\"height\":0.011627906376553643}]",
