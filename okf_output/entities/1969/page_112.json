      "event_name": "[{\"x\":0.33403361173482354,\"y\":0.8444767441393959,\"width\":0.40126050372456395,\"height\":0.03929659787563067,\"text\":\"SPORTS DAY\"},{\"x\":0.1596638786756079,\"y\":0.7717321312706898,\"width\":0.329831912018532,\"height\":0.013200257566001294,\"text\":\"The 38th Annual Athletic Meeting of\"},{\"x\":0.11554621678751097,\"y\":0.7572440437551198,\"width\":0.3739495707667151,\"height\":0.01165130502242695,\"text\":\"our school was held on December 12th，\"},{\"x\":0.11764706710379456,\"y\":0.7398255815069789,\"width\":0.252100830078125,\"height\":0.013233014712852542,\"text\":\"1968 at the Hong Kong\"},{\"x\":0.36764705619632126,\"y\":0.7427325580969566,\"width\":0.12184874068859014,\"height\":0.010326038232866042,\"text\":\"Government\"},{\"x\":0.11554621678751097,\"y\":0.723760463493341,\"width\":0.3739495707667151,\"height\":0.014611629233080903,\"text\":\"Stadium. The morning session was from\"},{\"x\":0.11764706287524263,\"y\":0.7092723760190689,\"width\":0.37184874068859014,\"height\":0.011657856697431357,\"text\":\"8.45 a.m. to 12.00 noon and the afternoon\"},{\"x\":0.11554622769437344,\"y\":0.6918604653525511,\"width\":0.3739495707667151,\"height\":0.014534883321060788,\"text\":\"session was from 2.00 p.m. to 5.30 p.m.\"},{\"x\":0.11764705840220348,\"y\":0.6757887960080032,\"width\":0.37184874068859014,\"height\":0.014618180294000083,\"text\":\"The weather was very suitable neither too\"},{\"x\":0.11764705877196262,\"y\":0.6613007082986484,\"width\":0.16806722951489822,\"height\":0.013200257566001294,\"text\":\"hot nor oppressive.\"},{\"x\":0.15966387180060804,\"y\":0.6307147455705058,\"width\":0.32983191201853196,\"height\":0.013200257566001294,\"text\":\"This year our school teams proved to\"},{\"x\":0.11764706194562086,\"y\":0.6162266583394613,\"width\":0.3718487406885901,\"height\":0.013200257566001294,\"text\":\"be reasonably successful and it was at our\"},{\"x\":0.11974791132596455,\"y\":0.6002906978332869,\"width\":0.3697478822220204,\"height\":0.013081395234588844,\"text\":\"athletic meeting that we discovered new\"},{\"x\":0.1176470545086462,\"y\":0.5843023256941207,\"width\":0.3718487406885901,\"height\":0.014538627398528403,\"text\":\"talent. Tsang Bing Chau, Ip Fuk Wah and\"},{\"x\":0.11974790263364601,\"y\":0.571152607786896,\"width\":0.3718487406885901,\"height\":0.011696229653441303,\"text\":\"Thomas Chok each broke two records.\"},{\"x\":0.11974790573772934,\"y\":0.5523255820045669,\"width\":0.3697478822220204,\"height\":0.015988371407532842,\"text\":\"Pang Hong Sai and Tsoi Chiu Sang also\"},{\"x\":0.11764705868176861,\"y\":0.5392441858518138,\"width\":0.3739495707667151,\"height\":0.01162790714811679,\"text\":\"established new ones and this made a total\"},{\"x\":0.11554623128276198,\"y\":0.5202833227290466,\"width\":0.37605040084484015,\"height\":0.01609787508048932,\"text\":\"of eight. Congratulations to H.S. Pang who\"},{\"x\":0.11974790321137715,\"y\":0.5072674419720952,\"width\":0.3718487406885901,\"height\":0.013081395234588844,\"text\":\"broke the A grade 800 metres record which\"},{\"x\":0.11974790393100669,\"y\":0.4912790697809615,\"width\":0.3697478822220203,\"height\":0.013228335383624668,\"text\":\"Mr. Robert Chung had kept for over thirty\"},{\"x\":0.11764706803050791,\"y\":0.4752092726174749,\"width\":0.37394957076671514,\"height\":0.013200257566001294,\"text\":\"years. His time was 2 minutes and 15.7\"},{\"x\":0.11974790659959285,\"y\":0.4593023260235781,\"width\":0.252100830078125,\"height\":0.01461911615984568,\"text\":\"seconds. Tsang Bing Chau，\"},{\"x\":0.36764706264853597,\"y\":0.457823567532911,\"width\":0.1260504150390625,\"height\":0.017467130328176594,\"text\":\"“C”grade, is\"},{\"x\":0.11974790743176844,\"y\":0.4446233094387647,\"width\":0.37394957076671514,\"height\":0.013225527786087876,\"text\":\"a very promising athlete and we hope that\"},{\"x\":0.11974790836664238,\"y\":0.4287790698427346,\"width\":0.3739495707667151,\"height\":0.013081395234588844,\"text\":\"he will continue to improve with practice.\"},{\"x\":0.12184874354751157,\"y\":0.4156471345431676,\"width\":0.3718487406885902,\"height\":0.011678446974204726,\"text\":\"His times for the 200 and 400 metres\"},{\"x\":0.11974789484478067,\"y\":0.39954925926772644,\"width\":0.37184874068859014,\"height\":0.011912427559562233,\"text\":\"events were better than those of the B\"},{\"x\":0.11974790836664238,\"y\":0.3821635541082973,\"width\":0.3739495707667151,\"height\":0.013200257566001294,\"text\":\"grade winners. He got the maximum num-\"},{\"x\":0.1218487426178898,\"y\":0.3662790698972406,\"width\":0.37184874068859014,\"height\":0.013081395234588733,\"text\":\"ber of points. The results of the Sports\"},{\"x\":0.1218487465044902,\"y\":0.3517441860854673,\"width\":0.24579831145530523,\"height\":0.013081395234588733,\"text\":\"Meeting can be seen below.\"},{\"x\":0.5692398059794432,\"y\":0.30665534018105434,\"width\":0.3216217182957849,\"height\":0.01193489448070828,\"text\":\"The Old And New 800 m. Record Holders.\"},{\"x\":0.5714285671617815,\"y\":0.29491307158779834,\"width\":0.3193277332394622,\"height\":0.011912427559562122,\"text\":\"Mr. R. Chung （1934） and H.s. Pang （1968.）\"},{\"x\":0.18697479017240703,\"y\":0.1438953491163243,\"width\":0.13025210358375727,\"height\":0.008720929747002448,\"text\":\"D Grade Athletics\"},{\"x\":0.3172268924108161,\"y\":0.1423052160096292,\"width\":0.10504201489825582,\"height\":0.010311063151166144,\"text\":\"Co-champions\"},{\"x\":0.1805845351369054,\"y\":0.1291364160861509,\"width\":0.061099839321402616,\"height\":0.012076005118935695,\"text\":\"K.Y. Lee\"},{\"x\":0.36340883024059845,\"y\":0.12924729198081442,\"width\":0.06519914494004359,\"height\":0.01040076472570417,\"text\":\"C.S. Tsoi\"},{\"x\":0.5882353041010281,\"y\":0.25144880906111367,\"width\":0.329831912018532,\"height\":0.014539562650288773,\"text\":\"The D.B.S. relay team came first in\"},{\"x\":0.542016809301804,\"y\":0.23535093350104475,\"width\":0.