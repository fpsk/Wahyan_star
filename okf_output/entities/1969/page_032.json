  "class_designation": "[{\"width\":0.07773108903751819,\"text\":\"Mrs. Yung\",\"height\":0.008745264101243433,\"x\":0.32352941475995234,\"y\":0.6075338054718702},{\"width\":0.17226890386537064,\"text\":\"and the Prize-Winning\",\"height\":0.010302640051513268,\"x\":0.40336134423328107,\"y\":0.607533805475388},{\"width\":0.09663865200308874,\"text\":\"Intermediate\",\"height\":0.010174418447559619,\"x\":0.5777310947967749,\"y\":0.6090116281550961},{\"width\":0.0399159666549328,\"text\":\"Choir\",\"height\":0.00875462337378452,\"x\":0.6827731097747745,\"y\":0.6104314229435153},{\"width\":0.14500458473382993,\"text\":\"21st H.K.\",\"height\":0.0176282048762727,\"x\":0.1512372019816709,\"y\":0.5144417114590764},{\"width\":0.1428571408293968,\"text\":\"SCHOOLS\",\"height\":0.01609787508048932,\"x\":0.15336134644454527,\"y\":0.4839021246585241},{\"width\":0.09663865200308866,\"text\":\"MUSIC\",\"height\":0.016097875080489432,\"x\":0.17647058943963215,\"y\":0.4520283322554347},{\"width\":0.14705881517986916,\"text\":\"FESTIVAL\",\"height\":0.015988371407532842,\"x\":0.14915966924830068,\"y\":0.4200581396777743},{\"width\":0.09033613338026891,\"text\":\"Fr. Deignan\",\"height\":0.010329781696248319,\"x\":0.4684873966239411,\"y\":0.34156976761124935},{\"height\":0.010312935496942455,\"text\":\"and Participants in\",\"x\":0.5651260570459197,\"y\":0.34288473891579085,\"width\":0.14705881517986918},{\"height\":0.008720929747002448,\"text\":\"the\",\"x\":0.7121848744156354,\"y\":0.3444767445741731,\"width\":0.03151260375976561},{\"height\":0.010174418447559619,\"text\":\"Verse-speaking Competitions\",\"x\":0.535714291670691,\"y\":0.32994186061633646,\"width\":0.20798318552416428},{\"height\":0.010415684539735959,\"text\":\"English\",\"x\":0.7520525538680177,\"y\":0.342902622719113,\"width\":0.0526175813896711},{\"height\":0.01747180965740458,\"text\":\"21st Hong Kong Schools' Music Festival\",\"x\":0.14495797748146505,\"y\":0.2732558143663698,\"width\":0.3424369776526162},{\"height\":0.017516768677190098,\"text\":\"For the very first time, this year Wah\",\"x\":0.17422935008593762,\"y\":0.24420181547948316,\"width\":0.33227760492369185},{\"height\":0.014639707050704165,\"text\":\"Yan entered a choir for the Schools'Music\",\"x\":0.13235294870277686,\"y\":0.23245331618686105,\"width\":0.37394957076671514},{\"height\":0.017413375766063832,\"text\":\"Festival, and to everyone's surprise and\",\"x\":0.1321926972449216,\"y\":0.2160809256367754,\"width\":0.3742840434229651},{\"height\":0.020008294719000896,\"text\":\"delight they were awarded first place in\",\"x\":0.13209109245584935,\"y\":0.19970058627676768,\"width\":0.3744900299781977},{\"height\":0.013235822310389334,\"text\":\"their Intermediate group.\",\"x\":0.13235294595107927,\"y\":0.18895348845344195,\"width\":0.21848739269167877},{\"height\":0.01162790714811679,\"text\":\"It was a tribute\",\"x\":0.3508403375906331,\"y\":0.19186046492158115,\"width\":0.15546217807503632},{\"height\":0.013200257566001294,\"text\":\"to the hard work and constant practice of\",\"x\":0.1302521042344429,\"y\":0.1757887959863168,\"width\":0.3760504008448401},{\"height\":0.014617244428154486,\"text\":\"the 40 boys who took part, and to the en-\",\"x\":0.13235294775739867,\"y\":0.15988372131185313,\"width\":0.3739495707667151},{\"height\":0.01162790714811679,\"text\":\"thusiasm and determination of our new\",\"x\":0.1323529494485751,\"y\":0.14680232558291828,\"width\":0.3739495707667151},{\"height\":0.014634091241545466,\"text\":\"music teacher, Mrs. Yung, who had had\",\"x\":0.13235294423849123,\"y\":0.13071474558613616,\"width\":0.3739495707667152},{\"height\":0.018915769597905308,\"text\":\"to start the year with raw, untrained voices.\",\"x\":0.1321693592326284,\"y\":0.1137724129844302,\"width\":0.3743653763172238},{\"height\":0.010302640051513157,\"text\":\"Our thanks and\",\"x\":0.13445378109790668,\"y\":0.10463618802191188,\"width\":0.14285714082939677},{\"height\":0.013081395234588733,\"text\":\"congratulations both to\",\"x\":0.2920168091134829,\"y\":0.10319767438488603,\"width\":0.21428570414698406},{\"height\":0.014534883321060788,\"text\":\"Mrs. Yung and all the choir members.\",\"x\":0.134453784361717,\"y\":0.08720930256185355,\"width\":0.34243697765261627},{\"height\":0.011734602609451361,\"text\":\"20\",\"x\":0.1302521009657248,\"y\":0.0552325579811741,\"width\":0.025210083362668056},{\"height\":0.014539563264374,\"text\":\"Apart from the choir,there were about\",\"x\":0.5714285728106145,\"y\":0.25144880857057506,\"width\":0.3508403263535611},{\"height\":0.014534883321060788,\"text\":\"40 other entries in various competitions of\",\"x\":0.54831933828611,\"y\":0.23982558183753155,\"width\":0.3739495707667151},{\"height\":0.014567641081997262,\"text\":\"the Festival, mostly in solo verse-speaking，\",\"x\":0.5483193369380709,\"y\":0.2252906978743533,\"width\":0.3739495707667151},{\"height\":0.014614436830617694,\"text\":\"both in English and Chinese. Li Chi Him\",\"x\":0.548319336003197,\"y\":0.21075581424063228,\"width\":0.3739495707667152},{\"height\":0.016137183902344976,\"text\":\"（F. 1D） got two Firsts,one of them with\",\"x\":0.546218500190325,\"y\":0.19607211818950265,\"width\":0.3760504008448401},{\"height\":0.013081395234588844,\"text\":\"an Honours Certificate for 93 marks. Al-\",\"x\":0.5483193436602128,\"y\":0.1860465117577056,\"width\":0.3760504008448401},{\"height\":0.014579807337990025,\"text\":\"together 8 boys won Honours Certificates\",\"x\":0.5483193356775667,\"y\":0.17151162828859756,\"width\":0.3739495707667152},{\"height\":0.01717592007255686,\"text\":\"（90 marks or more）， five of them in Chi-\",\"x\":0.5503247621590698,\"y\":0.1545085493479752,\"width\":0.36998171784156975},{\"height\":0.013219911976929066,\"text\":\"nese verse-speaking.\",\"x\":0.5504201721519439,\"y\":0.14389534896700795,\"width\":0.18067226676053771},{\"height\":0.010312934882857228,\"text\":\"There were also two\",\"x\":0.7352941195705454,\"y\":0.14680232564177254,\"width\":0.1848739411110102},{\"height\":0.013835174992862909,\"text\":\"entries for the Instrumental Ensemble com-\",\"x\":0.5502948377150578,\"y\":0.13190682125157394,\"width\":0.3741524629814681},{\"height\":0.017001641464479023,\"text\":\"petition.\",\"x\":0.5471806514611925,\"y\":0.11423380154421015,\"width\":0.07538908492687135},{\"height\":0.019131345435717817,\"text\":\"Including the choir, Wah Yan\",\"x\":0.6426498713027785,\"y\":0.11400268988594664,\"width\":0.2798567235192587},{\"height\":0.014638771184858568,\"text\":\"took 8 first places, 12 seconds and 9\",\"x\":0.5483193275893317,\"y\":0.10319767454586515,\"width\":0.3739495707667151},{\"height\":0.013232078847006945,\"text\":\"thirds.\",\"x\":0.5483193275316862,\"y\":0.09011627929040922,\"width\":0.056722688896711504}]",
