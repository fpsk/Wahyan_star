0.43882807460194806,\"width\":0.3781512593114099,\"height\":0.01481004507405026,\"text\":\"organized by the Ler's Get Together Club.\",\"x\":0.5021008456594209},{\"y\":0.42587209322319053,\"width\":0.3781512593114099,\"height\":0.014565768736220952,\"text\":\"Rev. Fr. Deignan, the Adviser of the club，\",\"x\":0.5021008456594209},{\"y\":0.4127495171234902,\"width\":0.3781512593114099,\"height\":0.013200257566001294,\"text\":\"was the supervisor of the competition. We\",\"x\":0.5021008362056397},{\"text\":\"had Mrs. Yung, Rev. Fr. Kane, the choir-\",\"height\":0.014534883321060788,\"x\":0.5000000095279215,\"y\":0.39825581421156264,\"width\":0.3802520893895349},{\"text\":\"mistress of St. Paul's Secondary School\",\"height\":0.014648129843314539,\"x\":0.5021008437686648,\"y\":0.38506117210064605,\"width\":0.3781512593114098},{\"text\":\"and Rev. Fr. O'Rourke as our judges. Li\",\"height\":0.013081395234588733,\"x\":0.5021008451342109,\"y\":0.372093023094915,\"width\":0.3781512593114098},{\"text\":\"Woon Kwong, the Vice-President of the\",\"height\":0.013200257566001294,\"x\":0.5021008456594209,\"y\":0.3589826143351379,\"width\":0.3781512593114099},{\"text\":\"club, was the Master of Ceremonies.\",\"height\":0.014534883321060899,\"x\":0.5021008471804183,\"y\":0.3444767443859812,\"width\":0.3319327704851017},{\"text\":\"Talent Time was divided into three\",\"height\":0.011683126303432712,\"x\":0.5483193349221066,\"y\":0.32122093034067023,\"width\":0.329831912018532},{\"text\":\"sections this year: Instrumental, Solo-vocal\",\"height\":0.014551730134451879,\"x\":0.5021008461374541,\"y\":0.3052157117077646,\"width\":0.3760504008448401},{\"text\":\"and Group-vocal\",\"height\":0.013217104379392275,\"x\":0.5021008482597199,\"y\":0.2920154538241424,\"width\":0.1533613338026889},{\"text\":\"sections.\",\"height\":0.01162790714811679,\"x\":0.6533613442694369,\"y\":0.29360465127090285,\"width\":0.0798319333098656},{\"text\":\"Most of them\",\"height\":0.01214120991369716,\"x\":0.7539391798331133,\"y\":0.2932723304306928,\"width\":0.1244700161246366},{\"text\":\"were from the senior forms.\",\"height\":0.017411444468108273,\"x\":0.5019170791881448,\"y\":0.27735635703289707,\"width\":0.27139943677325584},{\"text\":\"It is hoped\",\"height\":0.01478578809454456,\"x\":0.7793735032834156,\"y\":0.27749082737001873,\"width\":0.0988160173283067},{\"text\":\"that in future, more junior boys will take\",\"height\":0.020425471043632792,\"x\":0.5019065337352651,\"y\":0.26186815212268855,\"width\":0.37850006813226744},{\"text\":\"part.\",\"height\":0.011632586477344775,\"x\":0.5021008408532717,\"y\":0.2514488088602794,\"width\":0.04411764455396072},{\"text\":\"AQEN\",\"height\":0.04034163701634064,\"x\":0.5124415555472428,\"y\":0.17717840321284128,\"width\":0.1512523278524709},{\"text\":\"31\",\"height\":0.011640074018194668,\"x\":0.8550420171469485,\"y\":0.05376690292795683,\"width\":0.02310924263887626}]",
