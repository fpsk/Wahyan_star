  "class_designation": "[{\"text\":\"TEACH BETTER WITH LING KEE TEXTBOOKS！\",\"y\":0.868392195696726,\"width\":0.6435046670603197,\"height\":0.02707473892437895,\"x\":0.2707025469286433},{\"text\":\"*THE NEW ENGLISH COURSE FOR HONG KONG\",\"y\":0.8457823568852418,\"width\":0.3319327704851017,\"height\":0.010322294155398426,\"x\":0.14705882152215508},{\"text\":\"by S.E. Paces\",\"y\":0.8473837210632842,\"width\":0.08823528910792144,\"height\":0.010311063151166033,\"x\":0.5168067262968795},{\"text\":\"This most widely used Course offers a complete systematic programme of learning English as a second language.\",\"y\":0.8321420272392612,\"width\":0.7544016851380814,\"height\":0.016040158440662977,\"x\":0.14695822546030202},{\"text\":\"The\",\"y\":0.838662790988902,\"width\":0.03151260375976561,\"height\":0.008729353153697827,\"x\":0.8991596650318819},{\"text\":\"specially devised multi-purpose text provides ample practice in the four skills of listening, speaking, reading and writing, and\",\"y\":0.8203964315497619,\"width\":0.7817914244186046,\"height\":0.01593234043158187,\"x\":0.1469211330395683},{\"text\":\"the subject matter is well-varied and stimulating.\",\"y\":0.8095930233888655,\"width\":0.3088235260719477,\"height\":0.010174418447559619,\"x\":0.14705882905961432},{\"text\":\"All the tenses, sentence structures and vocabulary are perfectly controlled\",\"y\":0.8118187184808981,\"width\":0.464468028933503,\"height\":0.012445268673967447,\"x\":0.4662820641298036},{\"text\":\"and graded. New vocabulary items are progressively introduced in appropriate context and repeated at regular intervals. The\",\"y\":0.7958463213296962,\"width\":0.7838410133539244,\"height\":0.016802837521663005,\"x\":0.14694856163547726},{\"text\":\"unique feature of the Course is that it provides abundant drills in Spoken English by means of amusing dramatised stories\",\"y\":0.7861924137721948,\"width\":0.7837854287790698,\"height\":0.014945126623778782,\"x\":0.1469652820569281},{\"text\":\"and conversation pieces. All the textbooks are fully illustrated in full colour.\",\"y\":0.7746297485849893,\"width\":0.48109244413154073,\"height\":0.011707460657673696,\"x\":0.1470588168785574},{\"text\":\"Each textbook is accompanied by a Teacher's Book that gives step by step pre-tested teaching notes for every lesson.\",\"y\":0.7587209305077056,\"width\":0.7815125931140989,\"height\":0.013081395234588733,\"x\":0.14915967928328638},{\"text\":\"Additional practice in reading and writing skills is provided by Supplementary Readers and Workbooks, which are similarly\",\"y\":0.7443184639547611,\"width\":0.7817701898619186,\"height\":0.016942142749400757,\"x\":0.14903259076611067},{\"text\":\"graded to form an integral part of the Course.\",\"y\":0.733599534532755,\"width\":0.2860221543422965,\"height\":0.012906592197749811,\"x\":0.14895379438155465},{\"text\":\"（Junior 1-6）\",\"y\":0.7369186049666151,\"width\":0.07773108903751813,\"height\":0.008734968655814135,\"x\":0.44957983460413997},{\"text\":\"Pupil's Books\",\"y\":0.7179652284554253,\"width\":0.08613445193268535,\"height\":0.00877895742098278,\"x\":0.24369748099269092},{\"text\":\"Teacher's Books\",\"y\":0.71947674435615,\"width\":0.10294117062590841,\"height\":0.008791124291060659,\"x\":0.37184874113137356},{\"text\":\"Workbooks\",\"y\":0.7194767445014988,\"width\":0.07142857041469841,\"height\":0.008791124291060659,\"x\":0.5168067240888693},{\"text\":\"Supplementary Readers\",\"y\":0.7194767443372667,\"width\":0.1512605037245639,\"height\":0.010174418447559619,\"x\":0.6260504229276339},{\"text\":\"Junior 1\",\"y\":0.7061546412103492,\"width\":0.05268364839775616,\"height\":0.009202345524460642,\"x\":0.1805909488100577},{\"text\":\"Book\",\"y\":0.7063747585930704,\"width\":0.04411764455396078,\"height\":0.00874152033081832,\"x\":0.2436974809793221},{\"text\":\"Book 0\",\"y\":0.7071518775342942,\"width\":0.05713610272074854,\"height\":0.01011484972676846,\"x\":0.37164203323710865},{\"text\":\"BookO\",\"y\":0.7077266623623241,\"width\":0.05680012192837025,\"height\":0.008965280082098404,\"x\":0.5146671652182059},{\"text\":\"2\",\"y\":0.6947674421759173,\"width\":0.010504201844681121,\"height\":0.008720929747002448,\"x\":0.22478991601568465},{\"text\":\"3\",\"y\":0.6831395351991733,\"width\":0.010504201844681121,\"height\":0.008720929747002448,\"x\":0.22478991601568465},{\"text\":\"Books 1A-B\",\"y\":0.6947674418252702,\"width\":0.07352941468704577,\"height\":0.008720930361087675,\"x\":0.24579831790157514},{\"text\":\"Books 1A-B\",\"y\":0.6941534361563221,\"width\":0.07595524277797966,\"height\":0.011402430414616194,\"x\":0.37168624321520066},{\"text\":\"Books 1A-B\",\"y\":0.6960721184977098,\"width\":0.075630251862282,\"height\":0.009014810045074095,\"x\":0.514705881211716},{\"text\":\"Books 2A-B\",\"y\":0.683139534848526,\"width\":0.07352941468704577,\"height\":0.00874713613997724,\"x\":0.24579831790157514},{\"text\":\"Books 2A-B\",\"y\":0.6825512025185654,\"width\":0.07594246088072315,\"height\":0.011351083680574803,\"x\":0.37169263531036395},{\"text\":\"Books 2A-B\",\"y\":0.6844816484591263,\"width\":0.07352940758993465,\"height\":0.008832305151650122,\"x\":0.5168067255117554},{\"text\":\"Books 3A-B\",\"y\":0.669875971624487,\"width\":0.07782899368640989,\"height\":0.0105387545829424,\"x\":0.24364852966165534},{\"text\":\"Books 3A-B\",\"y\":0.6715116280770802,\"width\":0.075630251862282,\"height\":0.008784572923098977,\"x\":0.37184873866969936},{\"text\":\"Books 3A-B\",\"y\":0.6711067568380154,\"width\":0.07375451376271802,\"height\":0.010984160404242216,\"x\":0.5166941717289867},{\"text\":\"5\",\"y\":0.6584302326555685,\"width\":0.010504200957542259,\"height\":0.008720929747002448,\"x\":0.2247899164329936},{\"text\":\"Books 4A-B\",\"y\":0.6580958519836319,\"width\":0.07581223598746364,\"height\":0.010843179952077397,\"x\":0.2457073283280399},{\"text\":\"Books 4A-B\",\"y\":0.6598837211003361,\"width\":0.075630251862282,\"height\":0.008822009706220824,\"x\":0.37184873866969936},{\"text\":\"Books 4A-B\",\"y\":0.6597881083259622,\"width\":0.07568350148755443,\"height\":0.010365643964916016,\"x\":0.5167800992558302},{\"text\":\"Books 5A-B\",\"y\":0.6466371959220428,\"width\":0.07991848258085033,\"height\":0.010504677766995152,\"x\":0.24155336242171171},{\"text\":\"Books 5A-B\",\"y\":0.6481004506889845,\"width\":0.07773108903751813,\"height\":0.009014810045073984,\"x\":0.3718487424910448},{\"text\":\"Books 5A-B\",\"y\":0.6481004508749031,\"width\":0.07773108903751824,\"height\":0.009014810045073984,\"x\":0.5147058830810307},{\"text\":\"My Daily Life 1& 2\",\"y\":0.6947674415809804,\"width\":0.136554622206577,\"height\":0.0116279071481169,\"x\":0.6260504196740224},{\"text\":\"Two Brave Boys; Two Good Girls\",\"y\":0.684481648309429,\"width\":0.214285704146984,\"height\":0.010302640051513268,\"x\":0.6281512677164239},{\"text\":\"Three Dear Friends 1&2\",\"y\":0.6728911784228493,\"width\":0.16806722951489816,\"height\":0.010302640051513157,\"x\":0.6281512608728029},{\"text\":\"Six Nice Children\",\"y\":0.6613007083789242,\"width\":0.11134453352107554,\"height\":0.008757431278363814,\"x\":0.6281512637646722},{\"text\":\"1&2\",\"y\":0.6613007084393703,\"width\":0.05462184817291971,\"height\":0.010302640051513157,\"x\":0.7415966380283862},{\"text\":\"The Lost Child; Uncle Ho & the Thief\",\"y\":0.6481004510351676,\"width\":0.24369748137718017,\"height\":0.011912427559562122,\"x\":0.6281512623576283},{\"text\":\"*NEW ENGLISH WORKBOOKS FOR HONG KONG\",\"y\":0.6307147457743281,\"width\":0.33403360056322673,\"height\":0.008820137667487016,\"x\":0.14915966613120185},{\"text\":\"Books 1-8\",\"y\":0.6305870010550458,\"width\":0.07365780142850659,\"height\":0.010628323822119756,\"x\":0.49993580611125127},{\"text\":\"This well-known series of Workbooks is based on the new English syllabus for primary schools. Exercises on grammar，\",\"y\":0.6177325581022982,\"width\":0.783613394803779,\"height\":0.011694357307664993,\"x\":0.14915970221295602},{\"text\":\"sentence building, punctuation, vocabulary, comprehension, and composition have all been included in the series, so that\",\"y\":0.6046361882590832,\"width\":0.7857142532703489,\"height\":0.013200257566001294,\"x\":0.14915966699227706},{\"text\":\"it provides a complete junior course in written English.\",\"y\":0.5930232559220656,\"width\":0.3571428449763808,\"height\":0.011627907148116678,\"x\":0.14915967415046494},{\"text\":\"Each lesson constitutes a lesson, thus enabling teachers to adapt and\",\"y\":0.5943335479318927,\"width\":0.4306722667605378,\"height\":0.011912427559562122,\"x\":0.5042016745679105},{\"text\":\"select the material to suit the varying needs of different classes for better results.\",\"y\":0.5796515343379682,\"width\":0.5107211232739826,\"height\":0.01425123061200384,\"x\":0.14904662364701202},{\"text\":\"（Junior 1-6）\",\"y\":0.5843023257871214,\"width\":0.07983193330986549,\"height\":0.010174418447559619,\"x\":0.6680672272001092},{\"text\":\"*NEW COMPREHENSION COURSE FOR HONG KONG：\",\"y\":0.5653573728079837,\"width\":0.36764705214389537,\"height\":0.01030264035855577,\"x\":0.14915966260977512},{\"text\":\"ELEMENTARY COMPREHENSION FOR HONG KONG\",\"y\":0.5537669028386896,\"width\":0.3088235260719477,\"height\":0.008733097231165554,\"x\":0.18067227056535134},{\"text\":\"INTERMEDIATE COMPREHENSION FOR HONG KONG\",\"y\":0.5421511631061499,\"width\":0.3193277332394622,\"height\":0.008720929747002448,\"x\":0.18067227182564694},{\"text\":\"ADVANCED COMPREHENSION AND PRECIS FOR HONG KONG\",\"y\":0.5289761751928808,\"width\":0.3697478822220203,\"height\":0.010302640051513157,\"x\":0.18277312233436788},{\"text\":\"SCHOOL CERTIFICATE PRECIS AND COMPREHENSION FOR HONG KONG\",\"y\":0.5173857050295394,\"width\":0.43697478538335754,\"height\":0.01030264035855577,\"x\":0.18277311879291483},{\"text\":\"by\",\"y\":0.5552325583121767,\"width\":0.02310924263887626,\"height\":0.007267441660530505,\"x\":0.7058823538556319},{\"text\":\"Alan Stanford\",\"y\":0.555232558479212,\"width\":0.08823528910792156,\"height\":0.008836984480878107,\"x\":0.7310924409502408},{\"text\":\"Alan Stanford\",\"y\":0.5434642626971689,\"width\":0.07773108903751813,\"height\":0.009014810045074095,\"x\":0.7415966413268292},{\"text\":\"Ronald Parker\",\"y\":0.5318737925398838,\"width\":0.07773108903751813,\"height\":0.008823881744954631,\"x\":0.741596640433972},{\"text\":\"Ronald Parker\",\"y\":0.5202833227183454,\"width\":0.07773108903751824,\"height\":0.007405022537025019,\"x\":0.7415966402501485},{\"text\":\"This new comprehension course is the first attempt to cover the real needs of Chinese students. The first two volumes contain\",\"y\":0.4950710404697377,\"width\":0.7837987713481105,\"height\":0.0154570255905907,\"x\":0.15116920632512246},{\"text\":\"amusing short stories for reproduction and comprehension, while the other two are specially geared to the requirements of\",\"y\":0.4837772640942142,\"width\":0.7858818586482559,\"height\":0.014806635673016988,\"x\":0.15117084734375144},{\"text\":\"the School Certificate Examination.\",\"y\":0.47231165480570325,\"width\":0.2331932742096657,\"height\":0.010302640051513268,\"x\":0.15126050963886448},{\"text\":\"All the passages have been carefully graded and chosen as much on account of their\",\"y\":0.47383720907129045,\"width\":0.5399159702034884,\"height\":0.011674703510822337,\"x\":0.39495797228621127},{\"text\":\"interesting content as their suitability for reproduction, comprehension and precis work.\",\"y\":0.4607211850377092,\"width\":0.5546218091388082,\"height\":0.011662536026659232,\"x\":0.15126053324572172},{\"text\":\"*ELEMENTARY MAP READING FOR H.K. \\/ MAP READING FOR HONG KONG 1968 Edition\",\"y\":0.44462330988581444,\"width\":0.6323529478561046,\"height\":0.011912427559562233,\"x\":0.1512605114010789},{\"text\":\"by Pun & Fung\",\"y\":0.44622093025659815,\"width\":0.10084033345067223,\"height\":0.010314807228633649,\"x\":0.8151260505015546},{\"text\":\"These standard textbooks have been used by almost each and every secondary school in Hong Kong.\",\"y\":0.43303283937303716,\"width\":0.6638655409702034,\"height\":0.011734602609451472,\"x\":0.1512605151241418},{\"text\":\"contains many coloured photographs showing various physical features. In Map Reading for Hong Kong, the multi-coloured\",\"y\":0.4179706939536344,\"width\":0.7859304028888081,\"height\":0.016159654508002497,\"x\":0.15115963381206268},{\"text\":\"topographical maps in 4 different scales are given and, in addition, 8 more 1:25,000 maps and 2 Geological\\/Land Utilization\",\"y\":0.4073308295771877,\"width\":0.7858964503088662,\"height\":0.015229538956228916,\"x\":0.15116059562685222},{\"text\":\"Mans in full colour are now added to provide further practice. （F2-3, F4-5）\",\"y\":0.3966516418106164,\"width\":0.48739496275436045,\"height\":0.011912427559562122,\"x\":0.15126049572366027},{\"text\":\"*PHOTO AND WEATHER CHART READING FOR HONG KONG\",\"y\":0.3808139535124121,\"width\":0.42436974813771805,\"height\":0.010174418447559619,\"x\":0.15126049877777975},{\"text\":\"by Pun & Fung\",\"y\":0.3808139536214237,\"width\":0.10294117062590846,\"height\":0.010174418447559619,\"x\":0.6134453823603652},{\"text\":\"This new book contains numerous oblique and vertical aerial photographs, some of which are in full colour, showing\",\"y\":0.36767546711839194,\"width\":0.7857142532703488,\"height\":0.011684998035123795,\"x\":0.15126050732841143},{\"text\":\"various physical features of Hong Kong.\",\"y\":0.35608499690308304,\"width\":0.2563025186228197,\"height\":0.010302639744470654,\"x\":0.15126050966618101},{\"text\":\"The second part of the book deals with Weather Chart Reading. An invaluable book\",\"y\":0.3560849967751881,\"width\":0.5273109329578488,\"height\":0.011647561559044672,\"x\":0.40966386784355435},{\"text\":\"for School Certificate, G.C.E.， and Matriculation Examinations.\",\"y\":0.3428847390586013,\"width\":0.3970588151798692,\"height\":0.011912427559562122,\"x\":0.15126051333968715},{\"text\":\"*MODERN GEOGRAPHY FOR HONG KONG - ASIA\",\"y\":0.3270348838721505,\"width\":0.352941156431686,\"height\":0.010174418447559508,\"x\":0.15336136043961893},{\"text\":\"by Y.W. Fung\",\"y\":0.3283966515284964,\"width\":0.09243697055550504,\"height\":0.010302640051513268,\"x\":0.6134453811928356},{\"text\":\"This is the most authentic and up-to-date textbook on Asia, written by the author of \\\"Map Reading for Hong Kong\\\" series.\",\"y\":0.3154069768558161,\"width\":0.7815125931140988,\"height\":0.013081395234588844,\"x\":0.1533613602706814},{\"text\":\"The lucid text is fully illustrated with 150 maps and diagrams together with over 150 photographs and coloured plates. （F4-5）\",\"y\":0.3037790700425893,\"width\":0.7815125931140989,\"height\":0.013081395234588733,\"x\":0.15336136240653558},{\"text\":\"*NEW WORLD HISTORY FOR HONG KONG Books 1-3\",\"y\":0.28622021891861893,\"width\":0.38445377793422963,\"height\":0.010302640051513268,\"x\":0.1533613408298041},{\"text\":\"This new course will answer the crying need for a history course specially written for Hong Kong schools. These 3 books\",\"y\":0.27130760671885557,\"width\":0.7838522551780523,\"height\":0.01817960794403417,\"x\":0.15324395101923285},{\"text\":\"will cover the exact requirements of F.1-3, giving an interesting account of historical events from pre-historic days to the\",\"y\":0.26162790700006944,\"width\":0.7836134515806686,\"height\":0.011714011718592765,\"x\":0.15336135123172426},{\"text\":\"French Revolution. The text is written in simple English, and is fully illustrated with monochrome\\/coloured plates and maps.\",\"y\":0.25000000002332534,\"width\":0.779411734647529,\"height\":0.011751448808757226,\"x\":0.15546220964577304},{\"text\":\"*A SHORT HISTORY OF THE FAR EAST New Edition\",\"y\":0.2340116279310167,\"width\":0.3739495707667151,\"height\":0.010174418447559619,\"x\":0.15336134439605428},{\"text\":\"by W.H. Ha\",\"y\":0.23378511506045163,\"width\":0.07785230769667506,\"height\":0.010627444452112611,\"x\":0.6133847712978082},{\"text\":\"This widely used textbook gives a concise and authentic account of the impact of the West on the history of modern China\",\"y\":0.22086284619380814,\"width\":0.7815125931140988,\"height\":0.013200257566001294,\"x\":0.1554622005718017},{\"text\":\"and Japan. It covers adequately the requirements of the School Certificate Examination in History, Part 2.\",\"y\":0.20927237604329374,\"width\":0.6785713799055233,\"height\":0.011657856697431357,\"x\":0.15336138018029127},{\"text\":\"（F4-5）\",\"y\":0.21216999348791055,\"width\":0.04411764455396072,\"height\":0.008760238875900717,\"x\":0.8361344557692382},{\"text\":\"*NEW GENERAL SCIENCE FOR HONG KONG\",\"y\":0.19186046531594902,\"width\":0.32773108194040695,\"height\":0.010328845830402722,\"x\":0.15126051491214926},{\"text\":\"Books 1 & 2\",\"y\":0.1931745010745144,\"width\":0.08193277048510172,\"height\":0.009014810045073984,\"x\":0.47689075624904587},{\"text\":\"by J.Chan & Hong-Choy\",\"y\":0.19317450070619524,\"width\":0.1596638666197311,\"height\":0.010313871362788052,\"x\":0.6113445392741681},{\"text\":\"This two-year course meets the longfelt need for textbooks specially written for F.1 and 2. It follows closely the syllabus for\",\"y\":0.1802325581628601,\"width\":0.7815125931140989,\"height\":0.011654112619963741,\"x\":0.15546220060681598},{\"text\":\"General Science, and provides a well-balanced account of both theoretical and practical work. There are two companion\",\"y\":0.16860465116431367,\"width\":0.7815125931140989,\"height\":0.011691549710128202,\"x\":0.1554621986530345},{\"text\":\"Workbooks containing simple but interesting experiments.（F1-2）\",\"y\":0.1569767443857164,\"width\":0.42226888967114823,\"height\":0.010174418447559619,\"x\":0.15546220085770285},{\"text\":\"*A NEW CERTIFICATE CHEMISTRY FOR HONG KONG\",\"y\":0.14098837224424343,\"width\":0.37184874068859014,\"height\":0.010331653427939624,\"x\":0.155462187996041},{\"text\":\"by G. Hong-Choy\",\"y\":0.14098837224424332,\"width\":0.11554621496865924,\"height\":0.010331653427939513,\"x\":0.6113445415002642},{\"text\":\"This book has been written to meet the exact requirements of the new Chemistry syllabus for English School Certificate\",\"y\":0.12936046526749923,\"width\":0.783613394803779,\"height\":0.010174418447559619,\"x\":0.15546222322135925},{\"text\":\"Examination.\",\"y\":0.11622665800539078,\"width\":0.0924369705555051,\"height\":0.010302640051513157,\"x\":0.15546218853177124},{\"text\":\"The Author has made use of his 25 years' teaching experience to produce this excellent textbook for local\",\"y\":0.11622665802707721,\"width\":0.6911764739280524,\"height\":0.01168031870589592,\"x\":0.24579830613821518},{\"text\":\"students. There is a companion Workbook to go with the textbook.\",\"y\":0.10463618814909204,\"width\":0.4243697481377181,\"height\":0.010302640051513268,\"x\":0.15336134972315765},{\"text\":\"（F3-5）\",\"y\":0.10584144119950534,\"width\":0.04227702296057412,\"height\":0.01070083868710825,\"x\":0.5965085477614328},{\"text\":\"For inspection copies or further information, please write or telephone\",\"y\":0.08274307788642232,\"width\":0.5525210074491278,\"height\":0.014640642916549873,\"x\":0.17647059561892325},{\"text\":\"LING KEE PUBLISHING CO. 100-102 Percival Street, Hong Kong. Tel. 777490\",\"y\":0.06104651206409084,\"width\":0.7373949627543605,\"height\":0.01598837140753273,\"x\":0.17436975078068287},{\"text\":\"or visit LING KEE GROUP OF BOOK STORES, conveniently located in Hong Kong and Kowloon.\",\"y\":0.043464262456294867,\"width\":0.7373949627543605,\"height\":0.01481004507405026,\"x\":0.17647059317639105}]",
