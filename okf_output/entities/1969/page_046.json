      "club_name": "[{\"text\":\"Wah Yan （Hong Kong） Past Students AssoCiation Ltd.\",\"x\":0.1743697780331643,\"y\":0.8734707017388241,\"width\":0.7121848314861918,\"height\":0.020424646941293645},{\"text\":\"On the evening of Wednesday 15th\",\"x\":0.17647059531426346,\"y\":0.831294269198553,\"width\":0.329831912018532,\"height\":0.013200257566001294},{\"text\":\"January 1969 a meeting took place at Wah\",\"x\":0.132352942592833,\"y\":0.816806181823371,\"width\":0.3739495707667151,\"height\":0.013200257566001294},{\"text\":\"Yan College to discuss ways of reactivat-\",\"x\":0.1344537779400187,\"y\":0.8023180938121856,\"width\":0.3718487406885901,\"height\":0.014542370861910792},{\"text\":\"ing and developing the Wah\",\"x\":0.1302520970686331,\"y\":0.7891178363015094,\"width\":0.2731092444131541,\"height\":0.01481004507405026},{\"text\":\"Yan Past\",\"x\":0.4179973639619159,\"y\":0.7918918166765653,\"width\":0.08837501703306683,\"height\":0.012146599125416935},{\"text\":\"Students Association. Nearly thirty people\",\"x\":0.13025211228766398,\"y\":0.7746297487045684,\"width\":0.3760504008448401,\"height\":0.01609787508048932},{\"text\":\"attended. Many of these were representa-\",\"x\":0.13235294103470985,\"y\":0.763039278895726,\"width\":0.3739495707667151,\"height\":0.013200257566001294},{\"text\":\"tives of various Wah Yan Class Clubs\",\"x\":0.13235295834879174,\"y\":0.7514488090056284,\"width\":0.33613443064135173,\"height\":0.011632586477344775},{\"text\":\"they formed\",\"x\":0.13235294033747994,\"y\":0.7340116279252255,\"width\":0.11764705924100655,\"height\":0.014539563264374},{\"text\":\"a preparatory committee\",\"x\":0.2689075697587964,\"y\":0.735350933658506,\"width\":0.23739494856013815,\"height\":0.014649066323245252},{\"text\":\"which after a series of meetings and dis-\",\"x\":0.13235293947658658,\"y\":0.7223837209146824,\"width\":0.3739495707667151,\"height\":0.013081395234588733},{\"text\":\"cussions produced new constitutions which\",\"x\":0.13235294324059205,\"y\":0.707848837227551,\"width\":0.37394957076671514,\"height\":0.01462379610315867},{\"text\":\"would establish the Wah Yan （Hong Kong）\",\"x\":0.13445378362629315,\"y\":0.6960721185397694,\"width\":0.3718487406885902,\"height\":0.01323020711531575},{\"text\":\"Past Students Association Ltd.\",\"x\":0.13445379346627442,\"y\":0.6831395348949338,\"width\":0.28781511173691865,\"height\":0.011644753347422654},{\"text\":\"The old\",\"x\":0.4243300182175831,\"y\":0.6844575012683416,\"width\":0.08201222974200584,\"height\":0.011898950845751544},{\"text\":\"Association was for the graduates of the\",\"x\":0.13235293947658658,\"y\":0.6686046510987909,\"width\":0.3739495707667151,\"height\":0.013081395234588844},{\"text\":\"two Wah Yans. Now each school will have\",\"x\":0.13235294395837924,\"y\":0.654069767399547,\"width\":0.3739495707667151,\"height\":0.014635963587321887},{\"text\":\"its own Past Students Association.\",\"x\":0.1323529420404182,\"y\":0.6423052155261262,\"width\":0.31302521461664246,\"height\":0.013218040245237983},{\"text\":\"was thought advisable as each\",\"x\":0.13445379015227282,\"y\":0.6278171279898492,\"width\":0.27731090456940405,\"height\":0.013200257566001294},{\"text\":\"number of graduates increases and there is\",\"x\":0.13420890182103215,\"y\":0.6120841763586884,\"width\":0.37436946425327033,\"height\":0.018436974736082856},{\"text\":\"obviously a close bond between the gra-\",\"x\":0.13445377719772184,\"y\":0.6002906976588683,\"width\":0.37184874068859014,\"height\":0.013081395234588844},{\"text\":\"duates of the same school. However there\",\"x\":0.13235294103470985,\"y\":0.5885383130128277,\"width\":0.3739495707667151,\"height\":0.011912427559562122},{\"text\":\"will always be a close link between Wah\",\"x\":0.13445378676354786,\"y\":0.574050225474026,\"width\":0.37184874068859014,\"height\":0.013200257566001294},{\"text\":\"Yan Hong Kong and Wah Yan Kowloon\",\"x\":0.13445378401494856,\"y\":0.5595621374991777,\"width\":0.3718487406885901,\"height\":0.01456576935030618},{\"text\":\"and we hope in fact that many joint func-\",\"x\":0.13445379071958352,\"y\":0.5463618803083714,\"width\":0.3739495707667151,\"height\":0.013231142981161348},{\"text\":\"tions will be organised.\",\"x\":0.13445379078865727,\"y\":0.531873792388029,\"width\":0.20588234125181692,\"height\":0.014637835319013082},{\"text\":\"On 28th May 1969 the big day came\",\"x\":0.17647059369652462,\"y\":0.5144880875061919,\"width\":0.3319327704851017,\"height\":0.013200257566001294},{\"text\":\"when at a meeting held at the Ying King\",\"x\":0.13445379071958352,\"y\":0.5000000002726092,\"width\":0.3739495707667151,\"height\":0.014534883321060899},{\"text\":\"Restaurant the following office bearers of\",\"x\":0.13445379199759463,\"y\":0.4867997421478478,\"width\":0.373949570766715,\"height\":0.01481004507405026},{\"text\":\"the new association were elected：—\",\"x\":0.1323529557531241,\"y\":0.4752092723959339,\"width\":0.3235293933957122,\"height\":0.01170933238936478},{\"text\":\"President：\",\"x\":0.13229977470820298,\"y\":0.45038983328665727,\"width\":0.08624078794967296,\"height\":0.012011031220209523},{\"text\":\"Mr. YEUNG Nai Yiu\",\"x\":0.216386552842211,\"y\":0.43303283947697213,\"width\":0.19747899255087212,\"height\":0.01464157878239547},{\"text\":\"Vice-Presidents：\",\"x\":0.13445378269923244,\"y\":0.4200581396570342,\"width\":0.13655462220657702,\"height\":0.010174418447559508},{\"text\":\"Mr. LI Yiu Bor\",\"x\":0.21848739219177502,\"y\":0.4026162790360486,\"width\":0.1449579851017442,\"height\":0.013081395234588844},{\"text\":\"and\",\"x\":0.3046218495119239,\"y\":0.38953488392665636,\"width\":0.03151260375976561,\"height\":0.010174418447559508},{\"text\":\"Very Rev. Fr. A. J. Deignan, S.J.\",\"x\":0.16596639646277878,\"y\":0.370573084339092,\"width\":0.3109243561500727,\"height\":0.014601334094694218},{\"text\":\"Council：—\",\"x\":0.13230229213511363,\"y\":0.348663682438734,\"width\":0.0925382747206577,\"heigh