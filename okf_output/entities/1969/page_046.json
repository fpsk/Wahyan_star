dth\":0.3302378951671512,\"height\":0.01750953291127244},{\"text\":\"Past Students to make our Association a\",\"x\":0.5525210115254529,\"y\":0.3908564069981405,\"width\":0.3718487406885901,\"height\":0.011912427559562233},{\"text\":\"success by joining it and supporting its\",\"x\":0.5504201824294708,\"y\":0.37500000027260916,\"width\":0.3760504008448401,\"height\":0.01456857694784286},{\"text\":\"activities.\",\"x\":0.5503302851052456,\"y\":0.36306914065182705,\"width\":0.08001169603924418,\"height\":0.01223381150559466},{\"text\":\"Fr. R. Gallagher, the first Jesuit Prin-\",\"x\":0.5903361360313201,\"y\":0.3399871214194713,\"width\":0.33613445902979655,\"height\":0.016117529491417204},{\"text\":\"cipal of Wah Yan College, once said at the\",\"x\":0.548319333054379,\"y\":0.3270348841545184,\"width\":0.3781512593114099,\"height\":0.01598837140753273},{\"text\":\"inauguration of the Wah Yan Past Stu-\",\"x\":0.5504201824294708,\"y\":0.3154069770167952,\"width\":0.3760504008448401,\"height\":0.014599462363003024},{\"text\":\"dents\",\"x\":0.552521008761684,\"y\":0.3037790698755539,\"width\":0.04621848527775263,\"height\":0.011739281938679347},{\"text\":\"Association in 1935\",\"x\":0.6134453807423288,\"y\":0.3037790694879571,\"width\":0.19117645973383002,\"height\":0.011739281938679347},{\"text\":\"“Wah Yan\",\"x\":0.8172268915052708,\"y\":0.30521571124045765,\"width\":0.10714285207349206,\"height\":0.011644753961507881},{\"text\":\"College is your college. You as Wah Yan\",\"x\":0.5525210083841496,\"y\":0.2862202187788767,\"width\":0.3739495707667151,\"height\":0.016105362007254098},{\"text\":\"students carry its name with you wherever\",\"x\":0.5504201796983783,\"y\":0.27462974883427327,\"width\":0.3760504008448401,\"height\":0.014614436830617694},{\"text\":\"you go.\",\"x\":0.552521009782957,\"y\":0.260141661565912,\"width\":0.08613445193268532,\"height\":0.011660664294968037},{\"text\":\"You have done honour to its\",\"x\":0.647058827857013,\"y\":0.26303927891643