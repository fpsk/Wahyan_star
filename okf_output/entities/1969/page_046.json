        "text": "[{\"text\":\"Wah Yan （Hong Kong） Past Students AssoCiation Ltd.\",\"x\":0.1743697780331643,\"y\":0.8734707017388241,\"width\":0.7121848314861918,\"height\":0.020424646941293645},{\"text\":\"On the evening of Wednesday 15th\",\"x\":0.17647059531426346,\"y\":0.831294269198553,\"width\":0.329831912018532,\"height\":0.013200257566001294},{\"text\":\"January 1969 a meeting took place at Wah\",\"x\":0.132352942592833,\"y\":0.816806181823371,\"width\":0.3739495707667151,\"height\":0.013200257566001294},{\"text\":\"Yan College to discuss ways of reactivat-\",\"x\":0.1344537779400187,\"y\":0.8023180938121856,\"width\":0.3718487406885901,\"height\":0.014542370861910792},{\"text\":\"ing and developing the Wah\",\"x\":0.1302520970686331,\"y\":0.7891178363015094,\"width\":0.2731092444131541,\"height\":0.01481004507405026},{\"text\":\"Yan Past\",\"x\":0.4179973639619159,\"y\":0.7918918166765653,\"width\":0.08837501703306683,\"height\":0.012146599125416935},{\"text\":\"Students Association. Nearly thirty people\",\"x\":0.13025211228766398,\"y\":0.7746297487045684,\"width\":0.3760504008448401,\"height\":0.01609787508048932},{\"text\":\"attended. Many of these were representa-\",\"x\":0.13235294103470985,\"y\":0.763039278895726,\"width\":0.3739495707667151,\"height\":0.013200257566001294},{\"text\":\"tives of various Wah Yan Class Clubs\",\"x\":0.13235295834879174,\"y\":0.7514488090056284,\"width\":0.33613443064135173,\"height\":0.011632586477344775},{\"text\":\"they formed\",\"x\":0.13235294033747994,\"y\":0.7340116279252255,\"width\":0.11764705924100655,\"height\":0.014539563264374},{\"text\":\"a preparatory committee\",\"x\":0.2689075697587964,\"y\":0.735350933658506,\"width\":0.23739494856013815,\"height\":0.014649066323245252},{\"text\":\"which after a series of meetings and dis-\",\"x\":0.13235293947658658,\"y\":0.7223837209146824,\"width\":0.3739495707667151,\"height\":0.013081395234588733},{\"text\":\"cussions produced new constitutions which\",\"x\":0.13235