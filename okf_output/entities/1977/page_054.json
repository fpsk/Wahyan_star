      "club_name": "[{\"width\":0.3578528745926638,\"x\":0.5328031864611233,\"height\":0.03633725542198951,\"y\":0.07122090723934438,\"text\":\"SCOUTS\"},{\"width\":0.37574553192193066,\"x\":0.07157057775672841,\"height\":0.014534930996475404,\"y\":0.09156974389129724,\"text\":\"THE 15th HONG KONG\"},{\"width\":0.14982523382666268,\"x\":0.7213331360445292,\"height\":0.01648137716982967,\"y\":0.3834905612824755,\"text\":\"Group History\"},{\"width\":0.33001986416903406,\"x\":0.5447316241116392,\"height\":0.01598841390702932,\"y\":0.4069767232548187,\"text\":\"1926 - Scouting began in Wah Yan.\"},{\"width\":0.1699588252048866,\"x\":0.3731718899985932,\"height\":0.01734093967400463,\"y\":0.407430614650224,\"text\":\"The Scout Troop\"},{\"width\":0.30218688094467194,\"x\":0.07355864327517905,\"height\":0.014534922298468644,\"y\":0.4113371901952424,\"text\":\"was registered as the 28th Hong\"},{\"width\":0.7318500376002675,\"x\":0.07145694857582012,\"height\":0.020570686663400894,\"y\":0.4229149013480289,\"text\":\"Kong （Wah Yan） Troop, and was re-registered as the I5th Hong Kong （Wah Yan）\"},{\"width\":0.2147117247555982,\"x\":0.588469185176873,\"height\":0.014534911115317128,\"y\":0.44040696304699256,\"text\":\"Troop later in the year.\"},{\"width\":0.3339960162864861,\"x\":0.5387673938448286,\"height\":0.013081437524056216,\"y\":0.4578488158352745,\"text\":\"1932 - The Rover Crew was formed.\"},{\"width\":0.7994133988378732,\"x\":0.07346881429164852,\"height\":0.01892835262932302,\"y\":0.47350682629370555,\"text\":\"1937 - Our scouts took part in the closing ceremonies and procession of the Catholic Action\"},{\"width\":0.224652077849961,\"x\":0.5785288312870805,\"height\":0.015988400238732936,\"y\":0.4898255670560212,\"text\":\"Congress held in Canton.\"},{\"width\":0.6719681846904245,\"x\":0.2027832948814281,\"height\":0.015988458639635716,\"y\":0.5072673986416647,\"text\":\"1941 - Scout activities were suspended in December due to World War 1I.\"},{\"width\":0.8054520170106394,\"x\":0.06945038408449584,\"height\":0.0218891106521657,\"y\":0.521949414927579,\"text\":\"1946 - Scouting resumed in Wah Yan. The 15th Hong Kong Group （Wah Yan College）\"},{\"width\":0.2412086799607983,\"x\":0.5642420545669089,\"height\":0.01841686509719498,\"y\":0.539012900498804,\"text\":\"was formed on l6th April.\"},{\"width\":0.4711729651466411,\"x\":0.4035785214773755,\"height\":0.01598843130304295,\"y\":0.5581395052605425,\"text\":\"1949 - The Senior Scout Troop was formed in June.\"},{\"width\":0.5569590196252507,\"x\":0.27021815334170735,\"height\":0.01933876994378414,\"y\":0.5731945904128295,\"text\":\"- Raymond Yue, G.S.M.， was awarded the Cross of Gallentry.\"},{\"width\":0.803518529881768,\"x\":0.07138993607446804,\"height\":0.023872720923408197,\"y\":0.5855864243899371,\"text\":\"1951 - One of our scouts was selected as a members of the Hong Kong Contingent to the\"},{\"width\":0.30218688094467183,\"x\":0.5029821092692147,\"height\":0.014534922919754889,\"y\":0.606104631281805,\"text\":\"World Scout Jamboree in Austria.\"},{\"width\":0.7576213435480726,\"x\":0.0714886806710064,\"height\":0.01782116843357162,\"y\":0.6227794949825165,\"text\":\"-Ho Shiu Hay and Chan Kwok Chak （senior scouts） were awarded the Cross of\"},{\"width\":0.7335984065145946,\"x\":0.06958249914826947,\"height\":0.01744195459719977,\"y\":0.639534836286106,\"text\":\"Gallentry, presented by the Governor, for their bravery in saving a child in a squatter\"},{\"width\":0.03822098016313902,\"x\":0.7689849360816228,\"height\":0.015593024263164557,\"y\":0.6557441853244579,\"text\":\"fire.\"},{\"width\":0.8033929780630292,\"x\":0.07146604327873508,\"height\":0.018667710642861213,\"y\":0.671794935388112,\"text\":\"1952 - Sea Scouting began in Wah Yan with the formation of the Senior Sea Scout Troop\"},{\"width\":0.16302186962542475,\"x\":0.6421471141601174,\"height\":0.013081415779039207,\"y\":0.6904069665048602,\"text\":\"on 5th September.\"},{\"width\":0.7017892439735127,\