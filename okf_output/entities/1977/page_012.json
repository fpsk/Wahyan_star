      "club_name": "[{\"x\":0.6956809517469958,\"text\":\"SPEECH\",\"y\":0.0809878491658117,\"height\":0.04587313872595178,\"width\":0.23686871044138536},{\"x\":0.8091451283688774,\"text\":\"DAY\",\"y\":0.13808138659978553,\"height\":0.04796513361728938,\"width\":0.12127236758961413},{\"x\":0.4691848851177321,\"text\":\"YAO\",\"y\":0.11773254881493056,\"height\":0.04651164697901822,\"width\":0.11928430513052163},{\"x\":0.8290258433504047,\"text\":\"米\",\"y\":0.4709302314077941,\"height\":0.014534886263869118,\"width\":0.01789264712954164},{\"x\":0.8290258436568991,\"text\":\"米\",\"y\":0.5363372084973607,\"height\":0.0130813971404532,\"width\":0.01789264712954164},{\"width\":0.015904576170678197,\"height\":0.01162790925960977,\"text\":\"米\",\"x\":0.8290258429683389,\"y\":0.5537790685387998},{\"width\":0.019880719788359258,\"height\":0.017441863268128466,\"text\":\"米\",\"x\":0.8270377714179475,\"y\":0.6482558124066334},{\"width\":0.02186879074722259,\"height\":0.017441863268128466,\"text\":\"米\",\"x\":0.8250496998715842,\"y\":0.6642441845965559},{\"width\":0.01391650266188349,\"height\":0.008720931634064177,\"text\":\"米\",\"x\":0.8270377724099462,\"y\":0.8808139528602935},{\"width\":0.20079521954378343,\"height\":0.01453490863017226,\"text\":\"would the graduates\",\"x\":0.5228628268417598,\"y\":0.39970929011320844},{\"width\":0.2047713716612355,\"height\":0.015988398996160558,\"text\":\"forget that great day，\",\"x\":0.31212723834930267,\"y\":0.39825580070177435},{\"width\":0.03777336011808402,\"height\":0.011627911744754638,\"text\":\"26th\",\"x\":0.2644135184783053,\"y\":0.3982558115071907},{\"width\":0.4970178723122771,\"height\":0.015988436273332463,\"text\":\"November, 1976, the day our Annual Speech Day was held.\",\"x\":0.2624254585754716,\"y\":0.41424415415621174},{\"width\":0.4950298234528186,\"height\":0.013081458026500847,\"text\":\"This year we were glad to have Mr. Lee Chun Yon, the\",\"x\":0.2664015942179246,\"y\":0.4316860152164007},{\"width\":0.5328031869708111,\"height\":0.014534950877633901,\"text\":\"head of the Social Welfare Department, to be our guest and\",\"x\":0.2664015871805985,\"y\":0.4476743852079854},{\"width\":0.04373757809453682,\"height\":0.014534888749013875,\"text\":\"Mrs.\",\"x\":0.7554671946008429,\"y\":0.4636627883653186},{\"width\":0.4950298234528186,\"height\":0.014534945907344277,\"text\":\"Lee to give us the certificates. The ceremony began at\",\"x\":0.2644135259475467,\"y\":0.46366275965291703},{\"width\":0.07952285875398635,\"height\":0.013081405217173825,\"text\":\"5:30 p.m.\",\"x\":0.7196819102519001,\"y\":0.48110464613600257},{\"width\":0.49502982345281865,\"height\":0.014534945907344277,\"text\":\"After our Assistant Principal, Mr. Yu, had welcomed our\",\"x\":0.2664015843173283,\"y\":0.4956395037323744},{\"width\":0.22664015390868708,\"height\":0.014534912357889507,\"text\":\"guests, our Principal, Fr.\",\"x\":0.5725646137017202,\"y\":0.5116278924160165},{\"width\":0.2584492892505014,\"height\":0.013081428204763323,\"text\":\"Barrett, delivered his speech.\",\"x\":0.30616302610039553,\"y\":0.5130813789027056},{\"width\":0.029821072882721955,\"height\":0.011627911123468282,\"text\":\"He\",\"x\":0.2644135195974064,\"y\":0.5116279046654135},{\"width\":0.48906562247590796,\"height\":0.014534945907344277,\"text\":\"told us how the early students of Wah Yan had shown\",\"x\":0.3101391583942527,\"y\":0.5276162481582465},{\"width\":0.043737574694628356,\"height\":0.013081400868170556,\"text\":\"their\",\"x\":0.26441351925308343,\"y\":0.5261627880397519},{\"width\":0.29224652785030913,\"height\":0.015988408936739806,\"text\":\"regard for the poor. During the\",\"x\":0.5089463149267341,\"y\":0.5436046326500895},{\"width\":0.2385685830617758,\"height\":0.015988401481305314,\"text\":\"War in 1939, refugees kept\",\"x\":0.2644135200661963,\"y\":0.5436046367351225},{\"width\":0.5330645175328654,\"height\":0.02025811881894779,\"text\":\"pouring in Hong Kong. They needed help, and our boys\",\"x\":0.2662534065869766,\"y\":0.5575616001369262},{\"width\":0.1371769352605211,\"height\":0.011627924170478643,\"text\":\"answered them.\",\"x\":0.6620278328419066,\"y\":0.577034875124063},{\"width\":0.16020950616574753,\"height\":0.018943981704960478,\"text\":\"It is encouraging\",\"x\":0.4804219947925193,\"y\":0.5738368952158572},{\"width\":0.21073558623777988,\"height\":0.010174445608928107,\"text\":\"now to see Wal Yan\",\"x\":0.26640159321311796,\"y\":0.5784883586817278},{\"width\":0.5347912358302696,\"height\":0.015988441243622087,\"text\":\"students still making efforts in social work. Lastly, Fr. Barrett\",\"x\":0.2664016041325789,\"y\":0.5915697329392355},{\"width\":0.19085486644942062,\"height\":0.013081419506756342,\"text\":\"reminded us that we\",\"x\":0.6103379763843022,\"y\":0.6075581272379009},{\"width\":0.3439363693808489,\"height\":0.014534927268758269,\"text\":\"should not be working for credit from\",\"x\":0.2664016023539756,\"y\":0.6090116061815123},{\"width\":0.2842942236154049,\"height\":0.013081431932480458,\"text\":\"others, but from care for others.\",\"x\":0.5168986185766579,\"y\":0.6249999817808528},{\"width\":0.045725647353445975,\"height\":0.011627911744754527,\"text\":\"Next\",\"x\":0.7157057640303678,\"y\":0.6409883696605685},{\"width\":0.0994035785423456,\"height\":0.010174430698059345,\"text\":\"came the\",\"x\":0.6182902600992711,\"y\":0.6424418544910866},{\"width\":0.13804310953340854,\"height\":0.016143855365169157,\"text\":\"presentation of\",\"x\":0.4766955832114102,\"y\":0.6396530497256393},{\"width\":0.197451831185244,\"height\":0.018945225519932052,\"text\":\"certificates and prizes.\",\"x\":0.2679733837410578,\"y\":0.6375706431976395},{\"width\":0.532803186970811,\"height\":0.01453495087763379,\"text\":\"Sure every graduate had an unforgettable moment when he\",\"x\":0.2664015859049192,\"y\":0.6584301992220358},{\"width\":0.4058134517567681,\"height\":0.015863188703207687,\"text\":\"received the certificate from Mrs. Lee's hands.\",\"x\":0.39547614120617003,\"y\":0.6717059114310917},{\"width\":0.4970178723122772,\"height\":0.0145349477712029,\"text\":\"Then Mr. Lee, who had studied and also taught in Wah\",\"x\":0.2664016055933642,\"y\":0.6889534560363135},{\"width\":0.2783300226384944,\"height\":0.01453491857075151,\"text\":\"Yan, delivered to us his address.\",\"x\":0.5208747454733308,\"y\":0.7049418430402057},{\"width\":0.2365805070030499,\"height\":0.015988401481305314,\"text\":\"His subject was social work.\",\"x\":0.268389668599204,\"y\":0.7049418460374481},{\"width\":0.5330575001218527,\"height\":0.01899694138318786,\"text\":\"He said that social work, as a career, was comparatively new\",\"x\":0.2662662159162845,\"y\":0.7188313997435467},{\"width\":0.027833003623812802,\"height\":0.013081398383025689,\"text\":\"in\",\"x\":0.7733598405340181,\"y\":0.7369186029160453},{\"width\":0.5069582254066398,\"height\":0.014534948392489033,\"text\":\"Hong Kong. Due to rapid economic growth, many social\",\"x\":0.26640160933942353,\"y\":0.7383720607238136},{\"width\":0.532803186970811,\"height\":0.014534950877633901,\"text\":\"problems such as the generation gap, unemployment and vice\",\"x\":0.26640158210107573,\"y\":0.7543604314797877},{\"width\":0.5349604696725991,\"height\":0.01758119042610895,\"text\":\"appeared. They were waiting to be solved by social workers.\",\"x\":0.2663142269855994,\"y\":0.7699219703429134},{\"width\":0.5328031869708111,\"height\":0.01453495087763379,\"text\":\"To be a social worker, one should equip oneself with adequate\",\"x\":0.266401594089147,\"y\":0.7877906640597296},{\"width\":0.39960239022810834,\"height\":0.014534935345478894,\"text\":\"knowledge, and should have love for others.\",\"x\":0.3996023864714329,\"y\":0.8037790438262105},{\"width\":0.11928429153088793,\"height\":0.011627921685333775,\"text\":\"Mr. Lee also\",\"x\":0.2664015937971802,\"y\":0.8052325508336897},{\"width\":0.5347912358302696,\"height\":0.011627975115946931,\"text\":\"added that a social worker should work from interest but not\",\"x\":0.26441352186617745,\"y\":0.819767407761794},{\"width\":0.08548708013034756,\"height\":0.011627917336330396,\"text\":\"for riches.\",\"x\":0.715705763041188,\"y\":0.8357558084630522},{\"width\":0.4970178723122771,\"height\":0.013081459269073226,\"text\":\"The ceremony ended with a vote of thanks given by the\",\"x\":0.26640160683590897,\"y\":0.853197642440318},{\"width\":0.11133200769543439,\"height\":0.011627921685333775,\"text\":\"Head Prefect.\",\"x\":0.6858846908640124,\"y\":0.8691860391282633},{\"width\":0.41550694429938173,\"height\":0.014534935966765028,\"text\":\"And we had a performance given by our school\",\"x\":0.2664016043579299,\"y\":0.8691860204371601},{\"width\":0.17296222271978756,\"height\":0.013081417021611697,\"text\":\"orchestra and choir.\",\"x\":0.6262425459959711,\"y\":0.8851744075502407}]",
