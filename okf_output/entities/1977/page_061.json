393280355,\"y\":0.2775244302283637,\"height\":0.011726384364820874},{\"width\":0.18091451335505787,\"text\":\"alone raised about\",\"x\":0.2803180911355923,\"y\":0.2775244302768133,\"height\":0.011726384364820874},{\"width\":0.08185505314519274,\"text\":\"$22,000.\",\"x\":0.07935080446346197,\"y\":0.2595756756060954,\"height\":0.014278881557601264},{\"width\":0.29622265276849374,\"text\":\"The amount of money raised and\",\"x\":0.16302187596830442,\"y\":0.2586319220153117,\"height\":0.014657980456026065},{\"width\":0.3500867765430036,\"text\":\"the number of walkers set new records.\",\"x\":0.07943811985005157,\"y\":0.24560386774304155,\"height\":0.013687680520918177},{\"width\":0.3439363693808489,\"text\":\"During the Easter Holidays, another fun-\",\"x\":0.11729623312766688,\"y\":0.22964169354771335,\"height\":0.013090864299562965},{\"width\":0.38170973289884136,\"text\":\"fair for the orphans, organized by the Social\",\"x\":0.07952286138358153,\"y\":0.21366279091102536,\"height\":0.014675971040508218},{\"width\":0.38170973289884136,\"text\":\"Service Group of Maryknoll Convent School\",\"x\":0.07952286322254759,\"y\":0.19902280103671366,\"height\":0.014657980456025954},{\"width\":0.38170973289884136,\"text\":\"and our society was held at our school. This\",\"x\":0.07952287096608619,\"y\":0.18459302364618302,\"height\":0.013126846089813515},{\"width\":0.3797216568401153,\"text\":\"fun-fair was also preceded by a lecture and\",\"x\":0.07952286583938575,\"y\":0.16710097695064763,\"height\":0.016038557916200125},{\"width\":0.3797216568401153,\"text\":\"a Visit to an orphanage. Similarly, it was\",\"x\":0.07952287319028022,\"y\":0.15261627909900988,\"height\":0.014534883778724361},{\"width\":0.37989565055425584,\"text\":\"hoped that the workers would get a gencral\",\"x\":0.07941300041520251,\"y\":0.13619047748057556,\"height\":0.016457058785404377},{\"width\":0.38170973289884136,\"text\":\"picture of the orphans in Hong Kong before-\",\"x\":0.510934404325927,\"y\":0